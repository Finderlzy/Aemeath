+ * **The values are real.** They are read from and written to the authoritative
+ * config through the management API, because the character window lays out its
+ * subtitle with the same numbers. A settings field whose value only existed in
+ * this page would look like it worked and quietly do nothing.
+ *
+ * **Saving is not the same as taking effect.** Subtitle values are picked up on
+ * the character's next fetch and need no restart; that is stated after a save
+ * rather than left for the user to discover. A revision conflict is shown as a
+ * conflict, with the reason the edit was not applied.
+ */
+import { useCallback, useEffect, useState } from 'react';
+import {
+  Box, Button, Flex, Heading, Input, Text,
+} from '@chakra-ui/react';
+
+import {
+  fetchDesktopSettings,
+  fetchOverview,
+  ManagementError,
+  saveDesktopSettings,
+  type FieldError,
+} from '../../services/aemeath-management';
+
+interface Notice {
+  kind: 'ok' | 'error' | 'info';
+  text: string;
+}

diff --git a/src/main/management-window.ts b/src/main/management-window.ts
new file mode 100644
index 0000000..c0e6591
--- /dev/null
+++ b/src/main/management-window.ts
@@ -0,0 +1,144 @@
+import { BrowserWindow, shell } from 'electron';
+import { join } from 'path';
+
+/** Backend that serves the management page. Loopback only. */
+const MANAGEMENT_ORIGIN = process.env.AEMEATH_BACKEND_ORIGIN ?? 'http://127.0.0.1:12393';
+
+/** Path and query that select the management page. */
+const MANAGEMENT_URL = `${MANAGEMENT_ORIGIN}/?page=manage`;
+
+/**
+ * The user-facing management window.
+ *
+ * It is deliberately **not** the same kind of window as the character:
+ *
+ * * it loads the management page over HTTP from the backend, so the page works
+ *   even if the character session is closed or reconnecting;
+ * * it mounts no conversation provider, opens no microphone and plays no audio
+ *   — that is enforced in the renderer by `isManagementWindow()` selecting the
+ *   management page before any provider mounts;
+ * * closing it must not end the character, so it is a separate window rather
+ *   than a route inside the character window.
+ */
+export class ManagementWindowManager {
+  private window: BrowserWindow | null = null;
+
+  private loading = false;
+
+  // The IPC handler for opening this window is registered once, in the app
+  // entry point. Registering it here as well would throw
+  // "Attempted to register a second handler", which rejects inside
+  // `app.whenReady()` and stops the character window from ever being shown.
+
+  /**
+   * Open the management window, or focus it if it already exists.
+   *
+   * Keeping one instance means repeated clicks cannot accumulate windows, each
+   * of which would be another page polling the management API.
+   */
+  open(): { opened: boolean; focused: boolean; error: string } {
+    if (this.window && !this.window.isDestroyed()) {
+      if (this.window.isMinimized()) this.window.restore();
+      this.window.show();
+      this.window.focus();
+      return { opened: true, focused: true, error: '' };
+    }
+
+    this.window = new BrowserWindow({
+      width: 1100,
+      height: 760,
+      show: false,
+      title: 'Aemeath 管理',
+      autoHideMenuBar: true,
+      backgroundColor: '#171923',
+      icon: process.platform === 'win32'
+        ? join(__dirname, '../../resources/icon.ico')
+        : join(__dirname, '../../resources/icon.png'),
+      webPreferences: {
+        preload: join(__dirname, '../preload/index.js'),
+        sandbox: false,
+        contextIsolation: true,
+        nodeIntegration: true,
+      },
+    });
+
+    this.window.on('ready-to-show', () => {
+      this.window?.show();
+    });
+
+    this.window.on('closed', () => {
+      this.window = null;
+    });
+
+    // Links in the page must not navigate the window away from the UI.
+    this.window.webContents.setWindowOpenHandler((details) => {
+      shell.openExternal(details.url);
+      return { action: 'deny' };
+    });
+
+    this.load();
+
+    return { opened: true, focused: false, error: '' };
+  }
+
+  /**
+   * Load the management page, reporting a dead backend as a readable page.
+   *
+   * `did-fail-load` is the case that matters: if the backend is not running,
+   * an empty window would look like a broken button in the tray.
+   */
+  private load(): void {
+    if (!this.window) return;
+    this.loading = true;
+
+    this.window.webContents.on('did-fail-load', (_e, errorCode, errorDescription, validatedURL) => {
+      if (!this.window || this.loading === false) return;
+      console.warn('Management page failed to load:', errorCode, errorDescription, validatedURL);
+      this.renderUnavailable(errorDescription);
+    });
+
+    this.window.webContents.on('did-finish-load', () => {
+      this.loading = false;
+    });
+
+    this.window.loadURL(MANAGEMENT_URL);
+  }
+
+  /** Show why the page could not load, and how to fix it. */
+  private renderUnavailable(reason: string): void {
+    if (!this.window) return;
+    const html = `<!doctype html>
+<html lang="zh"><head><meta charset="utf-8"><title>Aemeath 管理</title>
+<style>
+ body{margin:0;font-family:system-ui,"Segoe UI",sans-serif;background:#171923;color:#e2e8f0;
+      display:flex;align-items:center;justify-content:center;height:100vh}
+ .card{max-width:560px;padding:28px 32px;border:1px solid #4a5568;border-radius:12px;background:#1a202c}
+ h1{margin:0 0 12px;font-size:18px}
+ p{margin:6px 0;font-size:14px;line-height:1.6;color:#cbd5e0}
+ code{background:#2d3748;padding:2px 6px;border-radius:4px;font-size:13px}
+</style></head><body><div class="card">
+<h1>无法连接管理服务</h1>
+<p>管理页面由后端提供，当前没有连上 <code>${MANAGEMENT_ORIGIN}</code>。</p>
+<p>原因：${reason || '连接被拒绝'}</p>
+<p>请先启动 Aemeath 后端，然后关闭本窗口并从托盘重新打开管理界面：</p>
+<p><code>python scripts/run_server.py</code></p>
+</div></body></html>`;
+    this.window.loadURL(`data:text/html;charset=utf-8,${encodeURIComponent(html)}`);
+  }
+
+  /** Close the management window without touching the character window. */
+  close(): void {
+    if (this.window && !this.window.isDestroyed()) {
+      this.window.close();
+    }
+    this.window = null;
+  }
+
+  getWindow(): BrowserWindow | null {
+    return this.window;
+  }
+
+  isOpen(): boolean {
+    return Boolean(this.window && !this.window.isDestroyed());
+  }
+}

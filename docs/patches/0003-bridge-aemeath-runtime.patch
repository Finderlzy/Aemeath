+    # ------------------------------------------------------------------
+    # Aemeath protocol handlers
+    #
+    # These are the only entry points through which an Aemeath client drives
+    # the character. They all delegate to the bridge so that turn arbitration,
+    # situation changes and output permission stay in one place. See
+    # docs/patches/0003-bridge-aemeath-runtime.patch.
+    # ------------------------------------------------------------------
+
+    def _aemeath_bridge(self, client_uid: str):
+        """Return the Aemeath bridge for a client, or ``None`` for other agents.
+
+        Non-Aemeath agents keep upstream's original behaviour: the bridge is
+        only present when the Aemeath agent created it.
+        """
+        context = self.client_contexts.get(client_uid)
+        if context is None:
+            return None
+        return getattr(context, "aemeath_bridge", None)
+
+    async def _handle_ai_speak_signal(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Ask Aemeath whether a proactive message is allowed right now.
+
+        For the Aemeath agent this never starts a conversation directly: the
+        backend scheduler is the single source of proactive turns, so the
+        request is handed to the bridge, which applies every eligibility rule
+        and only then generates. Other agents keep upstream's original path.
+        """
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            await self._handle_conversation_trigger(websocket, client_uid, data)
+            return
+        await bridge.request_proactive()
+
+    async def _handle_aemeath_hello(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Negotiate protocol version and hand the client its initial state."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            await websocket.send_text(
+                json.dumps(
+                    {
+                        "type": "aemeath-unavailable",
+                        "message": "this backend is not running the Aemeath agent",
+                    }
+                )
+            )
+            return
+
+        requested = int(data.get("protocol_version") or 0)
+        capabilities = data.get("capabilities") or []
+
+        from aemeath.bridge import PROTOCOL_VERSION
+
+        supported = min(requested, PROTOCOL_VERSION) if requested else 0
+        # A client that does not negotiate the Aemeath protocol is explicitly
+        # not treated as a full Aemeath client.
+        accepted = requested >= PROTOCOL_VERSION
+
+        await websocket.send_text(
+            json.dumps(
+                {
+                    "type": "aemeath-hello-ack",
+                    "protocol_version": PROTOCOL_VERSION,
+                    "negotiated_version": supported,
+                    "accepted": accepted,
+                    "capabilities": capabilities,
+                    "state": bridge.state_payload(),
+                }
+            )
+        )
+        if not accepted:
+            logger.warning(
+                "Client {} negotiated protocol {} (< {}); running in reduced mode.",
+                client_uid,
+                supported,
+                PROTOCOL_VERSION,
+            )
+
+    async def _handle_aemeath_set_mode(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Switch conversation mode through the ordered bridge path."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+
+        from aemeath.interfaces import SpeechMode
+
+        raw = str(data.get("mode") or "").strip()
+        try:
+            mode = SpeechMode(raw)
+        except ValueError:
+            await websocket.send_text(
+                json.dumps({"type": "error", "message": f"unknown mode: {raw}"})
+            )
+            return
+
+        await bridge.switch_mode(mode)
+
+    async def _handle_aemeath_set_switch(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Toggle microphone, screen observation or proactive chat."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+
+        name = str(data.get("switch") or "")
+        try:
+            await bridge.set_switch(name, bool(data.get("enabled")))
+        except ValueError as exc:
+            await websocket.send_text(
+                json.dumps({"type": "error", "message": str(exc)})
+            )
+
+    async def _handle_aemeath_screen_request(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Handle a manual "look at my screen" request."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+        await bridge.on_screen_request(force=bool(data.get("force", True)))
+
+    async def _handle_aemeath_activity(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Record whether the user is typing or speaking right now."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+        await bridge.on_client_activity(
+            typing=bool(data.get("typing")),
+            voice_active=bool(data.get("voice_active")),
+        )
+
+    async def _handle_aemeath_display_receipt(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Handle the client confirming text was actually displayed."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+        turn_id = str(data.get("turn_id") or "")
+        if not turn_id:
+            return
+        await bridge.on_display_receipt(turn_id=turn_id)
+        await bridge.on_display_text_shown(
+            turn_id=turn_id,
+            client_elapsed_ms=data.get("client_elapsed_ms"),
+            sample_source=data.get("sample_source"),
+        )
+
+    async def _handle_aemeath_playback_receipt(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Handle the client confirming a slice started or finished playing."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+        turn_id = str(data.get("turn_id") or "")
+        slice_id = str(data.get("audio_slice_id") or "")
+        if not turn_id:
+            return
+        elapsed = data.get("client_elapsed_ms")
+        if data.get("phase") == "finished":
+            await bridge.on_playback_finished(
+                turn_id=turn_id, audio_slice_id=slice_id, client_elapsed_ms=elapsed
+            )
+        else:
+            await bridge.on_playback_started(
+                turn_id=turn_id,
+                audio_slice_id=slice_id,
+                client_elapsed_ms=elapsed,
+                sample_source=data.get("sample_source"),
+            )
+
+    async def _handle_aemeath_cancel_receipt(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Handle the client confirming playback has fully stopped."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+        turn_id = str(data.get("turn_id") or "")
+        if turn_id:
+            await bridge.on_cancel_complete(
+                turn_id=turn_id,
+                client_elapsed_ms=data.get("client_elapsed_ms"),
+                sample_source=data.get("sample_source"),
+                trigger=data.get("trigger"),
+            )
+
+    async def _handle_aemeath_memory_query(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage
+    ) -> None:
+        """Serve the memory-management screen from the authoritative database."""
+        bridge = self._aemeath_bridge(client_uid)
+        if bridge is None:
+            return
+
+        store = bridge.memory_store
+        action = str(data.get("action") or "list")
+
+        if action == "search":
+            items = store.list_memories(query=str(data.get("query") or ""))
+        elif action == "forget":
+            outcome = store.forget(
+                str(data.get("memory_id") or ""),
+                fragments=data.get("fragments"),
+            )
+            await websocket.send_text(
+                json.dumps({"type": "aemeath-memory-forget-result", **outcome})
+            )
+            return
+        else:
+            items = store.list_memories()
+
+        await websocket.send_text(
+            json.dumps(
+                {
+                    "type": "aemeath-memory-list",
+                    "memories": [
+                        {
+                            "memory_id": item.memory_id,
+                            "kind": item.kind,
+                            "content": item.content,
+                            "created_at": item.created_at,
+                            "source_message_ids": list(
+                                store.evidence_for(item.memory_id)
+                            ),
+                        }
+                        for item in items
+                    ],
+                }
+            )
+        )
+
+    async def _handle_aemeath_import_legacy(
+        self, websocket: WebSocket, client_uid: str, data: WSMessage

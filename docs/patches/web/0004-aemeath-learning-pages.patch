     }),
   });
 }
+
+// ---------------------------------------------------------------------------
+// Expression and jargon learning (V2-T04)
+// ---------------------------------------------------------------------------
+
+/** One meaning of a learned item; jargon commonly has several. */
+export interface LearningMeaning {
+  kind_id: string;
+  meaning: string;
+  scenario: string;
+  /** `ok` or `needs_clarification`. */
+  state: string;
+  needs_clarification: boolean;
+}
+
+/** One source message a learned item came from. */
+export interface LearningSource {
+  message_id: string;
+  fragment: string;
+  content: string;
+  revision: number;
+}
+
+/** A learned expression or jargon word, as the page shows it. */
+export interface LearningItemView {
+  item_id: string;
+  /** `expression` or `jargon`; the two pages filter on it. */
+  kind: string;
+  content: string;
+  meaning: string;
+  scenario: string;
+  /** `candidate` / `enabled` / `disabled` / `revoked`. */
+  status: string;
+  origin: string;
+  manual_override: boolean;
+  check_result: string;
+  check_detail: string;
+  revision: number;
+  created_at: number;
+  updated_at: number;
+  last_used_at: number | null;
+  /** True while any meaning still needs the user to settle it. */
+  ambiguous: boolean;
+  meanings: LearningMeaning[];
+  sources: LearningSource[];
+}
+
+/**
+ * The learning page payload.
+ *
+ * `available` and `enabled` are separate from `items` on purpose: "nothing has
+ * been learned yet", "learning is switched off" and "learning is misconfigured"
+ * are three different situations, and rendering them all as an empty list
+ * leaves the user unable to tell whether to wait or to fix something.
+ */
+export interface LearningOverviewResponse {
+  ok: boolean;
+  available: boolean;
+  enabled: boolean;
+  error: string;
+  kind: string;
+  counts: Record<string, number>;
+  items: LearningItemView[];
+}
+
+/** Outcome of a learning edit, toggle, revoke or clarification. */
+export interface LearningActionResult {
+  ok: boolean;
+  error: string;
+  conflict: boolean;
+  item_id: string;
+  status: string;
+}
+
+/** List learned expressions or jargon. `kind` selects the page. */
+export async function fetchLearning(options: {
+  kind?: string;
+  status?: string;
+  query?: string;
+} = {}): Promise<LearningOverviewResponse> {
+  const params = new URLSearchParams();
+  if (options.kind) params.set('kind', options.kind);
+  if (options.status) params.set('status', options.status);
+  if (options.query) params.set('query', options.query);
+  const suffix = params.toString() ? `?${params.toString()}` : '';
+  return request<LearningOverviewResponse>(`/learning/overview${suffix}`);
+}
+
+/** The source messages behind one learned item. */
+export async function fetchLearningSources(
+  itemId: string,
+): Promise<{ ok: boolean; error: string; sources: LearningSource[] }> {
+  return request<{ ok: boolean; error: string; sources: LearningSource[] }>(
+    `/learning/${encodeURIComponent(itemId)}/sources`,
+  );
+}
+
+/**
+ * Apply a manual edit.
+ *
+ * An edit stamps the item as user-owned, and the backend will then refuse to
+ * let a later automatic result overwrite it. `expectedRevision` guards against
+ * two edits racing: a stale one comes back as a conflict rather than silently
+ * replacing the newer text.
+ */
+export async function editLearning(input: {
+  itemId: string;
+  content?: string;
+  meaning?: string;
+  scenario?: string;
+  expectedRevision?: number;
+}): Promise<LearningActionResult> {
+  return request<LearningActionResult>('/learning/edit', {
+    method: 'POST',
+    body: JSON.stringify({
+      item_id: input.itemId,
+      content: input.content ?? null,
+      meaning: input.meaning ?? null,
+      scenario: input.scenario ?? null,
+      expected_revision: input.expectedRevision ?? null,
+    }),
+  });
+}
+
+/** Enable or disable one item. `enabled` is required — never guessed. */
+export async function toggleLearning(
+  itemId: string,
+  enabled: boolean,
+): Promise<LearningActionResult> {
+  return request<LearningActionResult>('/learning/toggle', {
+    method: 'POST',
+    body: JSON.stringify({ item_id: itemId, enabled }),
+  });
+}
+
+/**
+ * Revoke one item.
+ *
+ * Terminal: the entry stops being used and cannot be re-learned from the same
+ * evidence. Restoring is deliberately not offered here for a revoked item.
+ */
+export async function revokeLearning(itemId: string): Promise<LearningActionResult> {
+  return request<LearningActionResult>('/learning/revoke', {
+    method: 'POST',
+    body: JSON.stringify({ item_id: itemId }),
+  });
+}
+
+/** Settle an ambiguous word's meanings with the user's answer. */
+export async function resolveLearningMeanings(

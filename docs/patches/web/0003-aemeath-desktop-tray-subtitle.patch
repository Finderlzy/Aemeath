@@ -0,0 +1,89 @@
+/* eslint-disable react/jsx-no-constructed-context-values */
+/**
+ * Desktop presentation settings: subtitle size and the character window.
+ *
+ * These live in the authoritative config through the management API rather than
+ * in `localStorage`, for the same reason every other V2 setting does: a value
+ * the user set in the management window must be the value the character window
+ * actually uses, and it must survive a reinstall.
+ *
+ * The defaults below are what the character uses while the settings are still
+ * loading, or when the backend cannot be reached. They are deliberately sane on
+ * their own — a card that has never been configured must still be readable.
+ */
+import React, {
+  createContext, useCallback, useContext, useEffect, useMemo, useState,
+} from 'react';
+
+import {
+  fetchDesktopSettings,
+  type DesktopSettings,
+} from '@/services/aemeath-management';
+
+/** Fallback values, used until the backend answers or if it cannot be reached. */
+export const DEFAULT_DESKTOP_SETTINGS: DesktopSettings = {
+  subtitle_font_size: 22,
+  subtitle_max_width: 520,
+  subtitle_dwell_ms: 4000,
+  character_width: 420,
+  character_height: 620,
+  character_scale: 1,
+  read_error: '',
+};
+
+interface DesktopSettingsContextValue {
+  settings: DesktopSettings;
+  /** Whether the values came from the backend rather than the fallback. */
+  loaded: boolean;
+  /** Why the settings could not be read, if they could not. */
+  error: string;
+  reload: () => Promise<void>;
+}
+
+const DesktopSettingsContext = createContext<DesktopSettingsContextValue>({
+  settings: DEFAULT_DESKTOP_SETTINGS,
+  loaded: false,
+  error: '',
+  reload: async () => {},
+});
+
+export function useDesktopSettings() {
+  return useContext(DesktopSettingsContext);
+}
+
+export function DesktopSettingsProvider({ children }: { children: React.ReactNode }) {
+  const [settings, setSettings] = useState<DesktopSettings>(DEFAULT_DESKTOP_SETTINGS);
+  const [loaded, setLoaded] = useState(false);
+  const [error, setError] = useState('');
+
+  const reload = useCallback(async () => {
+    try {
+      const data = await fetchDesktopSettings();
+      setSettings({ ...DEFAULT_DESKTOP_SETTINGS, ...data });
+      setError(data.read_error ?? '');
+      setLoaded(true);
+    } catch (err) {
+      // A failed read is not a reason to render nothing: the character keeps
+      // using the documented defaults, and the reason is available to the UI.
+      setError(err instanceof Error ? err.message : String(err));
+      setLoaded(true);
+    }
+  }, []);
+
+  useEffect(() => {
+    void reload();
+  }, [reload]);
+
+  const value = useMemo(
+    () => ({
+      settings, loaded, error, reload,
+    }),
+    [settings, loaded, error, reload],
+  );
+
+  return (
+    <DesktopSettingsContext.Provider value={value}>
+      {children}
+    </DesktopSettingsContext.Provider>
+  );
+}

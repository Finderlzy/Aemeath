+++ b/src/renderer/src/components/aemeath/manage-page.tsx
@@ -0,0 +1,409 @@
+/* eslint-disable @typescript-eslint/no-explicit-any */
+/**
+ * Aemeath management window.
+ *
+ * V2-T01 delivered the first management loop (overview, model, persona);
+ * V2-T02 adds voice, memory and Live2D. One rule runs through all of them:
+ * **what the user sees must be what is really configured, and "saved" must
+ * never be shown as "in effect"**.
+ *
+ * The component reads the backend overview on mount and after every save, so
+ * the displayed revision always comes from the file rather than from optimistic
+ * local state. A save that the backend rejects leaves the form filled in — the
+ * user's typing is not discarded because of a validation error.
+ *
+ * This page is deliberately separate from the character window: it performs no
+ * conversation, opens no microphone and plays no audio.
+ */
+import { useCallback, useEffect, useState } from 'react';
+import { Box, Button, Flex, Heading, Input, Text, Textarea } from '@chakra-ui/react';
+
+import {
+  describeEffectState,
+  fetchOverview,
+  ManagementError,
+  saveModel,
+  savePersona,
+  type FieldError,
+  type OverviewResponse,
+} from '../../services/aemeath-management';
+import Live2DPage from './live2d-page';
+import MemoryPage from './memory-page';
+import VoicePage from './voice-page';
+
+type Page = 'overview' | 'model' | 'persona' | 'voice' | 'memory' | 'live2d';
+
+const NAV: { id: Page; label: string }[] = [
+  { id: 'overview', label: '概览' },
+  { id: 'model', label: '模型' },
+  { id: 'persona', label: '人设' },
+  { id: 'voice', label: '声音' },
+  { id: 'memory', label: '记忆' },
+  { id: 'live2d', label: 'Live2D' },
+];
+
+/** Banner describing the outcome of the last action. */
+interface Notice {
+  kind: 'ok' | 'error' | 'info';
+  text: string;
+}
+
+const NOTICE_COLOR: Record<Notice['kind'], string> = {
+  ok: 'green.300',
+  error: 'red.300',
+  info: 'blue.200',
+};
+
+function errorText(errors: FieldError[], fallback: string): string {
+  if (!errors || errors.length === 0) return fallback;
+  return errors.map((e) => `${e.field}：${e.message}`).join('；');
+}
+
+export default function ManagePage(): JSX.Element {
+  const [page, setPage] = useState<Page>('overview');
+  const [overview, setOverview] = useState<OverviewResponse | null>(null);
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [loadError, setLoadError] = useState('');
+
+  const [baseUrl, setBaseUrl] = useState('');
+  const [model, setModel] = useState('');
+  const [apiKey, setApiKey] = useState('');
+
+  const [identity, setIdentity] = useState('');
+  const [personality, setPersonality] = useState('');
+  const [replyStyle, setReplyStyle] = useState('');
+
+  const applyOverview = useCallback((data: OverviewResponse) => {
+    setOverview(data);
+    setBaseUrl(data.model.base_url);
+    setModel(data.model.model);
+    setIdentity(data.persona.identity);
+    setPersonality(data.persona.personality);
+    setReplyStyle(data.persona.reply_style);
+  }, []);
+
+  const reload = useCallback(async () => {
+    try {
+      const data = await fetchOverview();
+      applyOverview(data);
+      setLoadError('');
+    } catch (error) {
+      // A failed read is shown as its own state rather than as an empty form,
+      // because an empty form invites the user to "fix" a value that is fine.
+      setLoadError(error instanceof Error ? error.message : String(error));
+    }
+  }, [applyOverview]);
+
+  useEffect(() => {
+    void reload();
+  }, [reload]);
+
+  /**
+   * Run one save and fold the result back into the screen.
+   *
+   * The API key field is cleared on success only: after a rejected save the user
+   * would otherwise have to retype a value that was never wrong.
+   */
+  const runSave = async (
+    action: () => Promise<any>,
+    successText: string,
+    onSuccess?: () => void,
+  ) => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await action();
+      if (result?.ok) {
+        onSuccess?.();
+        const effect = result.restart_required
+          ? '已保存，重启 Aemeath 后生效。'
+          : '已保存，且运行中的服务已使用该配置。';
+        setNotice({ kind: 'ok', text: `${successText}${effect}` });
+      } else {
+        setNotice({
+          kind: 'error',
+          text: errorText(result?.errors ?? [], result?.message || '保存失败。'),
+        });
+      }
+      await reload();
+    } catch (error) {
+      const conflict =
+        error instanceof ManagementError && (error as ManagementError).status === 409;
+      if (conflict) {
+        // A conflict is recoverable and must be explained, not hidden: the user
+        // needs to know their edit was not applied because the file moved on.
+        setNotice({
+          kind: 'error',
+          text: '配置已被其他操作修改，你的改动没有保存。页面已刷新为最新配置。',
+        });
+        await reload();
+      } else {
+        setNotice({
+          kind: 'error',
+          text: error instanceof Error ? error.message : String(error),
+        });
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const effect = overview ? describeEffectState(overview) : null;
+
+  return (
+    <Flex minHeight="100vh" background="gray.900" color="white">
+      <Box width="180px" padding="4" borderRightWidth="1px" borderColor="whiteAlpha.300">
+        <Heading size="sm" marginBottom="4">
+          Aemeath 管理
+        </Heading>
+        {NAV.map((item) => (
+          <Button
+            key={item.id}
+            display="block"
+            width="100%"
+            marginBottom="2"
+            variant={page === item.id ? 'solid' : 'ghost'}
+            colorPalette={page === item.id ? 'blue' : undefined}
+            onClick={() => setPage(item.id)}
+          >
+            {item.label}
+          </Button>
+        ))}
+      </Box>
+
+      <Box flex="1" padding="6" overflowY="auto">
+        {loadError && (
+          <Box
+            background="red.900"
+            borderWidth="1px"
+            borderColor="red.400"
+            padding="3"
+            marginBottom="4"
+            borderRadius="md"
+          >
+            <Text fontWeight="bold">无法读取配置</Text>
+            <Text fontSize="sm">{loadError}</Text>
+            <Button size="sm" marginTop="2" onClick={() => void reload()}>
+              重试
+            </Button>
+          </Box>
+        )}
+
+        {notice && (
+          <Box
+            background="blackAlpha.400"
+            borderWidth="1px"
+            borderColor={NOTICE_COLOR[notice.kind]}
+            padding="3"
+            marginBottom="4"
+            borderRadius="md"
+          >
+            <Text fontSize="sm">{notice.text}</Text>
+          </Box>
+        )}
+
+        {effect && (
+          <Box
+            background="blackAlpha.300"
+            borderWidth="1px"
+            borderColor={effect.pending ? 'orange.300' : 'green.300'}
+            padding="3"
+            marginBottom="4"
+            borderRadius="md"
+          >
+            <Text fontWeight="bold">{effect.label}</Text>
+            <Text fontSize="sm">{effect.detail}</Text>
+          </Box>
+        )}
+
+        {page === 'overview' && overview && (
+          <Box>
+            <Heading size="md" marginBottom="4">
+              概览
+            </Heading>
+            <Text fontSize="sm" marginBottom="1">
+              配置文件：{overview.config_path}
+            </Text>
+            <Text fontSize="sm" marginBottom="1">
+              已保存修订：{overview.saved_revision || '(无)'}
+            </Text>
+            <Text fontSize="sm" marginBottom="4">
+              运行中修订：{overview.running_revision || '(无)'}
+            </Text>
+
+            <Heading size="sm" marginBottom="2">
+              当前对话模型
+            </Heading>
+            <Text fontSize="sm">连接：{overview.model.provider || '(未配置)'}</Text>
+            <Text fontSize="sm">服务地址：{overview.model.base_url || '(未配置)'}</Text>
+            <Text fontSize="sm">模型：{overview.model.model || '(未配置)'}</Text>
+            <Text fontSize="sm" marginBottom="4">
+              凭据：
+              {overview.model.api_key_configured
+                ? `已配置${overview.model.api_key_env ? `（来自 ${overview.model.api_key_env}）` : ''}`
+                : '未配置'}
+            </Text>
+
+            <Heading size="sm" marginBottom="2">
+              当前人设来源
+            </Heading>
+            <Text fontSize="sm">
+              {overview.persona.mode === 'split' ? '三字段（身份／性格／回复风格）' : '旧原文'}
+            </Text>
+          </Box>
+        )}
+
+        {page === 'model' && (
+          <Box maxWidth="640px">
+            <Heading size="md" marginBottom="4">
+              模型
+            </Heading>
+            <Text fontSize="sm" marginBottom="4">
+              使用 OpenAI 兼容协议。服务地址可指向任意兼容端点，不限于特定厂商。
+            </Text>
+
+            <Text fontSize="sm" marginBottom="1">
+              服务地址
+            </Text>
+            <Input
+              value={baseUrl}
+              onChange={(e) => setBaseUrl(e.target.value)}
+              placeholder="https://api.example.com/v1"
+              marginBottom="3"
+            />
+
+            <Text fontSize="sm" marginBottom="1">
+              模型名称
+            </Text>
+            <Input
+              value={model}
+              onChange={(e) => setModel(e.target.value)}
+              placeholder="model-name"
+              marginBottom="3"
+            />
+
+            <Text fontSize="sm" marginBottom="1">
+              凭据
+            </Text>
+            <Input
+              type="password"
+              value={apiKey}
+              onChange={(e) => setApiKey(e.target.value)}
+              placeholder={
+                overview?.model.api_key_configured ? '已配置（留空则保持不变）' : '填写后保存到本机凭据存储'
+              }
+              marginBottom="1"
+            />
+            <Text fontSize="xs" color="whiteAlpha.700" marginBottom="4">
+              凭据保存在本机，不会写入配置文件，也不会回显。管理密钥需要重启后生效。
+            </Text>
+
+            <Button
+              colorPalette="blue"
+              disabled={busy || !overview}
+              onClick={() =>
+                void runSave(
+                  () =>
+                    saveModel({
+                      baseUrl,
+                      model,
+                      apiKey,
+                      expectedRevision: overview!.saved_revision,
+                    }),
+                  '模型配置已保存。',
+                  () => setApiKey(''),
+                )
+              }
+            >
+              保存
+            </Button>
+          </Box>
+        )}
+
+        {page === 'persona' && (
+          <Box maxWidth="640px">
+            <Heading size="md" marginBottom="4">
+              人设
+            </Heading>
+
+            {overview?.persona.mode === 'legacy' && (
+              <Box
+                background="blackAlpha.400"
+                borderWidth="1px"
+                borderColor="orange.300"
+                padding="3"
+                marginBottom="4"
+                borderRadius="md"
+              >
+                <Text fontSize="sm" fontWeight="bold">
+                  当前使用旧人设原文
+                </Text>
+                <Text fontSize="sm">
+                  保存下面的三项后才会切换到三字段；原文会保留，不会被自动改写。
+                </Text>
+                <Text fontSize="xs" whiteSpace="pre-wrap" marginTop="2" color="whiteAlpha.800">
+                  {overview.persona.legacy_prompt}
+                </Text>
+              </Box>
+            )}
+
+            <Text fontSize="sm" marginBottom="1">
+              身份（她是谁）
+            </Text>
+            <Textarea
+              value={identity}
+              onChange={(e) => setIdentity(e.target.value)}
+              marginBottom="3"
+              rows={3}
+            />
+
+            <Text fontSize="sm" marginBottom="1">
+              性格（稳定倾向）
+            </Text>
+            <Textarea
+              value={personality}
+              onChange={(e) => setPersonality(e.target.value)}
+              marginBottom="3"
+              rows={3}
+            />
+
+            <Text fontSize="sm" marginBottom="1">
+              回复风格（措辞、语气与长度）
+            </Text>
+            <Textarea
+              value={replyStyle}
+              onChange={(e) => setReplyStyle(e.target.value)}
+              marginBottom="3"
+              rows={3}
+            />
+
+            <Button
+              colorPalette="blue"
+              disabled={busy || !overview}
+              onClick={() =>
+                void runSave(
+                  () =>
+                    savePersona({
+                      identity,
+                      personality,
+                      replyStyle,
+                      expectedRevision: overview!.saved_revision,
+                    }),
+                  '人设已保存。',
+                )
+              }
+            >
+              保存
+            </Button>
+          </Box>
+        )}
+        {page === 'voice' && <VoicePage />}
+
+        {page === 'memory' && <MemoryPage />}
+
+        {page === 'live2d' && <Live2DPage />}
+      </Box>
+    </Flex>
+  );
+}

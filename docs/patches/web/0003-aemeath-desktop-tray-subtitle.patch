+++ b/src/main/desktop-settings.ts
@@ -0,0 +1,192 @@
+/**
+ * Desktop presentation settings, read by the Electron main process.
+ *
+ * The management window writes these values through the management API into the
+ * authoritative config file. The character window has to use those same values
+ * — the V2 acceptance criterion is that a saved configuration actually takes
+ * effect, and a main process that only knew its own hardcoded defaults would
+ * make the settings page decorative.
+ *
+ * The file is read directly rather than over HTTP because the character window
+ * must place itself correctly **before** the backend is necessarily reachable;
+ * a window that waited on a network round trip would either start in the wrong
+ * place or start late.
+ *
+ * Failure is never fatal: an unreadable or absent config falls back to the
+ * documented defaults, which is the same behaviour the character has on a
+ * machine that has never opened the settings page.
+ */
+
+import { readFileSync } from 'fs';
+import { join } from 'path';
+
+/** What the character window needs to know. */
+export interface DesktopSettings {
+  characterWidth: number;
+  characterHeight: number;
+  characterScale: number;
+  subtitleFontSize: number;
+  subtitleMaxWidth: number;
+  subtitleDwellMs: number;
+}
+
+/** Defaults, mirroring `aemeath/management/desktop.py`. */
+export const DEFAULT_DESKTOP_SETTINGS: DesktopSettings = {
+  characterWidth: 420,
+  characterHeight: 620,
+  characterScale: 1,
+  subtitleFontSize: 22,
+  subtitleMaxWidth: 520,
+  subtitleDwellMs: 4000,
+};
+
+/**
+ * Candidate locations of the authoritative config.
+ *
+ * `AEMEATH_CONFIG` is what the launcher sets, so an acceptance run with its own
+ * config is honoured. The relative paths are a convenience for a development
+ * tree; they cannot be relied on for a packaged build, where the release
+ * directory is nested too deeply to reach the repository root by traversal.
+ */
+export function configCandidates(): string[] {
+  const candidates: string[] = [];
+  const fromEnv = process.env.AEMEATH_CONFIG;
+  if (fromEnv) candidates.push(fromEnv);
+
+  // <client>/config/conf.aemeath.yaml and progressively shallower guesses.
+  const appDir = __dirname;
+  for (const depth of [2, 3, 4, 5, 6, 7]) {
+    const up = Array(depth).fill('..');
+    candidates.push(join(appDir, ...up, 'config', 'conf.aemeath.yaml'));
+  }
+  return candidates;
+}
+
+/** Where the backend serves the management API. */
+const MANAGEMENT_ORIGIN = process.env.AEMEATH_BACKEND_ORIGIN ?? 'http://127.0.0.1:12393';
+
+/**
+ * Read the desktop settings from the backend.
+ *
+ * The backend is the authority: it is the process that read the config, and its
+ * answer is the same one the management page shows. Reaching it over HTTP is
+ * also what makes an acceptance run with a non-default `AEMEATH_CONFIG`
+ * work — the app would otherwise have to guess where that file lives.
+ *
+ * Returns `null` when the backend is unreachable, so the caller can fall back
+ * to reading the file directly.
+ */
+export async function fetchDesktopSettings(): Promise<DesktopSettings | null> {
+  const url = `${MANAGEMENT_ORIGIN}/aemeath/manage/desktop/settings`;
+  try {
+    const response = await fetch(url, { signal: AbortSignal.timeout(4000) });
+    if (!response.ok) return null;
+    const data = (await response.json()) as Record<string, unknown>;
+    return {
+      characterWidth: asNumber(data.character_width, DEFAULT_DESKTOP_SETTINGS.characterWidth),
+      characterHeight: asNumber(data.character_height, DEFAULT_DESKTOP_SETTINGS.characterHeight),
+      characterScale: asNumber(data.character_scale, DEFAULT_DESKTOP_SETTINGS.characterScale),
+      subtitleFontSize: asNumber(data.subtitle_font_size, DEFAULT_DESKTOP_SETTINGS.subtitleFontSize),
+      subtitleMaxWidth: asNumber(data.subtitle_max_width, DEFAULT_DESKTOP_SETTINGS.subtitleMaxWidth),
+      subtitleDwellMs: asNumber(data.subtitle_dwell_ms, DEFAULT_DESKTOP_SETTINGS.subtitleDwellMs),
+    };
+  } catch {
+    // Not running yet, or refused: the caller falls back to the file.
+    return null;
+  }
+}
+
+function asNumber(value: unknown, fallback: number): number {
+  const parsed = typeof value === 'string' ? Number(value) : value;
+  return typeof parsed === 'number' && Number.isFinite(parsed) ? parsed : fallback;
+}
+
+/**
+ * Extract the `aemeath_config.desktop` block from a YAML document.
+ *
+ * This is a deliberately small scanner rather than a YAML parser: the main
+ * process must not carry a dependency for six numbers, and the values it needs
+ * are all scalars on their own lines under two known keys. Anything it cannot
+ * find falls back to the default, so a config it fails to parse is a cosmetic
+ * problem rather than a broken window.
+ */
+export function parseDesktopSection(text: string): Partial<DesktopSettings> {
+  const result: Partial<DesktopSettings> = {};
+
+  // Find the `desktop:` block nested under character_config > aemeath_config.
+  const lines = text.split(/\r?\n/);
+  let desktopIndent: number | null = null;
+  const block: string[] = [];
+
+  for (const line of lines) {
+    if (line.trim().startsWith('#') || line.trim() === '') continue;
+    const indent = line.length - line.trimStart().length;
+    const trimmed = line.trim();
+
+    if (desktopIndent === null) {
+      if (/^desktop:\s*$/.test(trimmed)) {
+        desktopIndent = indent;
+      }
+      continue;
+    }
+
+    // The block ends at the first line that is not deeper than its header.
+    if (indent <= desktopIndent) break;
+    block.push(trimmed);
+  }
+
+  const fieldMap: Record<string, keyof DesktopSettings> = {
+    character_width: 'characterWidth',
+    character_height: 'characterHeight',
+    character_scale: 'characterScale',
+    subtitle_font_size: 'subtitleFontSize',
+    subtitle_max_width: 'subtitleMaxWidth',
+    subtitle_dwell_ms: 'subtitleDwellMs',
+  };
+
+  for (const entry of block) {
+    const match = /^([a-z_]+):\s*(-?[\d.]+)\s*$/.exec(entry);
+    if (!match) continue;
+    const key = fieldMap[match[1]];
+    if (!key) continue;
+    result[key] = Number(match[2]);
+  }
+
+  return result;
+}
+
+/**
+ * Load the desktop settings, falling back to the defaults.
+ *
+ * A missing file, unreadable file or absent section all resolve to the
+ * defaults; the caller is told which source was used so a diagnostic can say
+ * why the character is a default size.
+ */
+export function loadDesktopSettings(): {
+  settings: DesktopSettings;
+  source: string;
+} {
+  for (const candidate of configCandidates()) {
+    let text: string;
+    try {
+      text = readFileSync(candidate, 'utf8');
+    } catch {
+      continue;
+    }
+    const parsed = parseDesktopSection(text);
+    if (Object.keys(parsed).length === 0) continue;
+    return {
+      settings: {
+        characterWidth: asNumber(parsed.characterWidth, DEFAULT_DESKTOP_SETTINGS.characterWidth),
+        characterHeight: asNumber(parsed.characterHeight, DEFAULT_DESKTOP_SETTINGS.characterHeight),
+        characterScale: asNumber(parsed.characterScale, DEFAULT_DESKTOP_SETTINGS.characterScale),
+        subtitleFontSize: asNumber(parsed.subtitleFontSize, DEFAULT_DESKTOP_SETTINGS.subtitleFontSize),
+        subtitleMaxWidth: asNumber(parsed.subtitleMaxWidth, DEFAULT_DESKTOP_SETTINGS.subtitleMaxWidth),
+        subtitleDwellMs: asNumber(parsed.subtitleDwellMs, DEFAULT_DESKTOP_SETTINGS.subtitleDwellMs),
+      },
+      source: candidate,
+    };
+  }
+
+  return { settings: { ...DEFAULT_DESKTOP_SETTINGS }, source: '' };
+}

index 0000000..68c29ef
--- /dev/null
+++ b/src/renderer/src/components/aemeath/learning-page.tsx
@@ -0,0 +1,509 @@
+/* eslint-disable @typescript-eslint/no-explicit-any */
+/**
+ * Expression and jargon learning pages (v2 task V2-T04).
+ *
+ * Both pages are one store viewed two ways, so they share this component and
+ * differ only in the `kind` they filter on. Splitting them would duplicate the
+ * candidate/revoke/forget logic, which is exactly where the two would drift.
+ *
+ * Four rules from the acceptance criteria shape the screen:
+ *
+ * 1. **"Nothing learned yet" and "learning is not running" are different.**
+ *    The backend reports `available` and `enabled` separately from the item
+ *    list. Learning is off by default, so a page that showed a bare empty list
+ *    would leave the user waiting for results that can never arrive.
+ * 2. **A candidate is labelled as a candidate.** Entries the checks would not
+ *    confirm are shown with the reason, and are visibly *not* in use. Showing
+ *    a rejected item as learned would misrepresent what the character knows.
+ * 3. **Where it came from is always visible.** Every entry lists its source
+ *    messages and the located span, so "why does she say that" is answerable.
+ * 4. **Revoking is terminal and says so.** The page does not offer "restore"
+ *    for a revoked entry, because the backend refuses it; offering a button
+ *    that cannot work would be worse than not offering one.
+ *
+ * Nothing here rewrites the persona: these pages manage style notes only.
+ */
+import { useCallback, useEffect, useState } from 'react';
+import { Box, Button, Flex, Heading, Input, Text, Textarea } from '@chakra-ui/react';
+
+import {
+  editLearning,
+  fetchLearning,
+  ManagementError,
+  resolveLearningMeanings,
+  revokeLearning,
+  toggleLearning,
+  type LearningItemView,
+  type LearningOverviewResponse,
+} from '../../services/aemeath-management';
+
+interface Notice {
+  kind: 'ok' | 'error' | 'info';
+  text: string;
+}
+
+const NOTICE_COLOR: Record<Notice['kind'], string> = {
+  ok: 'green.300',
+  error: 'red.300',
+  info: 'blue.200',
+};
+
+/** Human labels for the four states, so the page never shows a raw enum. */
+const STATUS_LABEL: Record<string, string> = {
+  candidate: '候选（未启用）',
+  enabled: '已启用',
+  disabled: '已禁用',
+  revoked: '已撤销',
+};
+
+const STATUS_COLOR: Record<string, string> = {
+  candidate: 'orange.300',
+  enabled: 'green.300',
+  disabled: 'whiteAlpha.600',
+  revoked: 'red.300',
+};
+
+interface Props {
+  /** `expression` or `jargon`; selects the page's slice of the store. */
+  kind: string;
+  title: string;
+  description: string;
+  /** Wording for the primary field, which differs between the two pages. */
+  contentLabel: string;
+}
+
+export default function LearningPage({
+  kind,
+  title,
+  description,
+  contentLabel,
+}: Props): JSX.Element {
+  const [listing, setListing] = useState<LearningOverviewResponse | null>(null);
+  const [loadError, setLoadError] = useState('');
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [statusFilter, setStatusFilter] = useState('');
+  const [query, setQuery] = useState('');
+
+  const [editingId, setEditingId] = useState('');
+  const [editContent, setEditContent] = useState('');
+  const [editMeaning, setEditMeaning] = useState('');
+  const [editScenario, setEditScenario] = useState('');
+
+  const [clarifyingId, setClarifyingId] = useState('');
+  const [clarifyText, setClarifyText] = useState('');
+
+  /**
+   * Load the list.
+   *
+   * A load failure is held separately from the payload so the two states render
+   * differently: an empty list from a working read is a result, an error is not.
+   */
+  const load = useCallback(async () => {
+    try {
+      const data = await fetchLearning({
+        kind,
+        status: statusFilter,
+        query,
+      });
+      setListing(data);
+      setLoadError('');
+    } catch (error) {
+      setListing(null);
+      setLoadError(error instanceof Error ? error.message : String(error));
+    }
+  }, [kind, statusFilter, query]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const run = async (action: () => Promise<any>, successText: string, after?: () => void) => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await action();
+      if (result?.ok) {
+        setNotice({ kind: 'ok', text: successText });
+        after?.();
+      } else {
+        setNotice({ kind: 'error', text: result?.error || '操作失败。' });
+      }
+      await load();
+    } catch (error) {
+      const payload = error instanceof ManagementError ? error.payload : null;
+      setNotice({
+        kind: 'error',
+        text: (payload as any)?.error || (error instanceof Error ? error.message : String(error)),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const startEdit = (item: LearningItemView) => {
+    setEditingId(item.item_id);
+    setEditContent(item.content);
+    setEditMeaning(item.meaning);
+    setEditScenario(item.scenario);
+  };
+
+  const doEdit = async (item: LearningItemView) => {
+    if (!editContent.trim()) {
+      setNotice({ kind: 'error', text: '内容不能为空。' });
+      return;
+    }
+    await run(
+      () =>
+        editLearning({
+          itemId: item.item_id,
+          content: editContent,
+          meaning: editMeaning,
+          scenario: editScenario,
+          // The revision guards against two edits racing: the backend answers a
+          // stale one with a conflict instead of silently replacing newer text.
+          expectedRevision: item.revision,
+        }),
+      '已保存修改。人工修改优先于后续自动学习结果。',
+      () => setEditingId(''),
+    );
+  };
+
+  const doToggle = async (item: LearningItemView, enabled: boolean) => {
+    await run(
+      () => toggleLearning(item.item_id, enabled),
+      enabled ? '已启用，会在合适语境中使用。' : '已禁用，不再用于回复。',
+    );
+  };
+
+  const doRevoke = async (item: LearningItemView) => {
+    await run(
+      () => revokeLearning(item.item_id),
+      '已撤销这次学习：不再使用，也不会从同一段对话里重新学回。',
+    );
+  };
+
+  const doClarify = async (item: LearningItemView) => {
+    if (!clarifyText.trim()) {
+      setNotice({ kind: 'error', text: '请填写这条黑话的含义。' });
+      return;
+    }
+    await run(
+      () =>
+        resolveLearningMeanings(item.item_id, [
+          { meaning: clarifyText.trim(), scenario: item.scenario },
+        ]),
+      '已记录含义，之后会按这个含义使用。',
+      () => {
+        setClarifyingId('');
+        setClarifyText('');
+      },
+    );
+  };
+
+  const notRunning = listing !== null && !listing.available;
+  const items = listing?.items ?? [];
+
+  return (
+    <Box maxWidth="900px">
+      <Heading size="md" marginBottom="2">
+        {title}
+      </Heading>
+      <Text fontSize="sm" color="whiteAlpha.800" marginBottom="2">
+        {description}
+      </Text>
+      <Text fontSize="xs" color="whiteAlpha.700" marginBottom="4">
+        学习只使用你与爱弥斯的对话，结果保存在本机数据库中，可随时修改、禁用或撤销。
+        自动学习不会改写核心人设。
+      </Text>
+
+      {notice && (
+        <Box
+          background="blackAlpha.400"
+          borderWidth="1px"
+          borderColor={NOTICE_COLOR[notice.kind]}
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontSize="sm">{notice.text}</Text>
+        </Box>
+      )}
+
+      {loadError && (
+        <Box
+          background="red.900"
+          borderWidth="1px"
+          borderColor="red.400"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">无法读取学习条目</Text>
+          <Text fontSize="sm">{loadError}</Text>
+          <Button size="sm" marginTop="2" onClick={() => void load()}>
+            重试
+          </Button>
+        </Box>
+      )}
+
+      {notRunning && listing && (
+        <Box
+          background="orange.900"
+          borderWidth="1px"
+          borderColor="orange.300"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">学习没有在运行，这不是「还没有学到东西」</Text>
+          <Text fontSize="sm">{listing.error}</Text>
+          <Text fontSize="xs" marginTop="1" color="whiteAlpha.800">
+            下面列出的条目来自本地数据库，仍然可以查看、修改或撤销；
+            但爱弥斯不会在对话中继续学习新内容。
+          </Text>
+        </Box>
+      )}
+
+      <Flex marginBottom="3" gap="2" wrap="wrap">
+        <Input
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+          placeholder="搜索内容或含义"
+          maxWidth="260px"
+          onKeyDown={(e) => {
+            if (e.key === 'Enter') void load();
+          }}
+        />
+        <Button
+          size="sm"
+          variant={statusFilter === '' ? 'solid' : 'ghost'}
+          onClick={() => setStatusFilter('')}
+        >
+          全部
+        </Button>
+        {['enabled', 'candidate', 'disabled', 'revoked'].map((value) => (
+          <Button
+            key={value}
+            size="sm"
+            variant={statusFilter === value ? 'solid' : 'ghost'}
+            onClick={() => setStatusFilter(value)}
+          >
+            {STATUS_LABEL[value]}
+          </Button>
+        ))}
+      </Flex>
+
+      {listing && listing.ok && items.length === 0 && (
+        <Text fontSize="sm" color="whiteAlpha.700" marginBottom="4">
+          {query.trim() || statusFilter
+            ? '没有符合条件的条目。'
+            : '还没有学到任何内容。与她多聊几句，学到的东西会出现在这里。'}
+        </Text>
+      )}
+
+      {items.map((item) => (
+        <Box
+          key={item.item_id}
+          borderWidth="1px"
+          borderColor="whiteAlpha.300"
+          borderRadius="md"
+          padding="3"
+          marginBottom="3"
+        >
+          {editingId === item.item_id ? (
+            <Box>
+              <Text fontSize="xs" color="whiteAlpha.700" marginBottom="1">
+                {contentLabel}
+              </Text>
+              <Input
+                value={editContent}
+                onChange={(e) => setEditContent(e.target.value)}
+                marginBottom="2"
+              />
+              {kind === 'jargon' && (
+                <>
+                  <Text fontSize="xs" color="whiteAlpha.700" marginBottom="1">
+                    含义
+                  </Text>
+                  <Input
+                    value={editMeaning}
+                    onChange={(e) => setEditMeaning(e.target.value)}
+                    marginBottom="2"
+                  />
+                </>
+              )}
+              <Text fontSize="xs" color="whiteAlpha.700" marginBottom="1">
+                适用场景
+              </Text>
+              <Textarea
+                value={editScenario}
+                onChange={(e) => setEditScenario(e.target.value)}
+                rows={2}
+                marginBottom="2"
+              />
+              <Button
+                size="sm"
+                colorPalette="blue"
+                marginRight="2"
+                disabled={busy}
+                onClick={() => void doEdit(item)}
+              >
+                保存修改
+              </Button>
+              <Button size="sm" variant="ghost" onClick={() => setEditingId('')}>
+                取消
+              </Button>
+            </Box>
+          ) : (
+            <Box>
+              <Flex align="center" gap="2" wrap="wrap">
+                <Text fontSize="sm" fontWeight="bold">
+                  {item.content}
+                </Text>
+                <Text fontSize="xs" color={STATUS_COLOR[item.status] ?? 'whiteAlpha.600'}>
+                  {STATUS_LABEL[item.status] ?? item.status}
+                </Text>
+                {item.manual_override && (
+                  <Text fontSize="xs" color="blue.200">
+                    已人工修改
+                  </Text>
+                )}
+                {item.origin === 'manual' && (
+                  <Text fontSize="xs" color="blue.200">
+                    手动添加
+                  </Text>
+                )}
+              </Flex>
+
+              {kind === 'jargon' && item.meanings.length > 0 && (
+                <Box marginTop="1">
+                  {item.meanings.map((meaning) => (
+                    <Text key={meaning.kind_id} fontSize="xs" color="whiteAlpha.800">
+                      含义：{meaning.meaning}
+                      {meaning.scenario ? `（适用场景：${meaning.scenario}）` : ''}
+                      {meaning.needs_clarification ? '　⚠ 含义待确认' : ''}
+                    </Text>
+                  ))}
+                </Box>
+              )}
+
+              {kind !== 'jargon' && item.scenario && (
+                <Text fontSize="xs" color="whiteAlpha.800" marginTop="1">
+                  适用场景：{item.scenario}
+                </Text>
+              )}
+
+              {item.check_detail && (
+                <Text fontSize="xs" color="orange.300" marginTop="1">
+                  未启用原因：{item.check_detail}
+                </Text>
+              )}
+
+              {item.sources.length > 0 && (
+                <Box marginTop="2">
+                  <Text fontSize="xs" color="whiteAlpha.700">
+                    来源消息：
+                  </Text>
+                  {item.sources.map((source) => (
+                    <Text
+                      key={source.message_id}
+                      fontSize="xs"
+                      color="whiteAlpha.700"
+                      whiteSpace="pre-wrap"
+                    >
+                      · {source.content || '（来源消息已被遗忘）'}
+                    </Text>
+                  ))}
+                </Box>
+              )}
+
+              {clarifyingId === item.item_id ? (
+                <Box marginTop="2">
+                  <Input
+                    value={clarifyText}
+                    onChange={(e) => setClarifyText(e.target.value)}
+                    placeholder="这条黑话在你这里是什么意思？"
+                    marginBottom="2"
+                  />
+                  <Button
+                    size="sm"
+                    colorPalette="blue"
+                    marginRight="2"
+                    disabled={busy}
+                    onClick={() => void doClarify(item)}
+                  >
+                    保存含义
+                  </Button>
+                  <Button size="sm" variant="ghost" onClick={() => setClarifyingId('')}>
+                    取消
+                  </Button>
+                </Box>
+              ) : (
+                <Flex marginTop="2" gap="2" wrap="wrap">
+                  <Button
+                    size="sm"
+                    variant="ghost"
+                    disabled={busy}
+                    onClick={() => startEdit(item)}
+                  >
+                    编辑
+                  </Button>
+                  {item.ambiguous && (
+                    <Button
+                      size="sm"
+                      colorPalette="orange"
+                      disabled={busy}
+                      onClick={() => {
+                        setClarifyingId(item.item_id);
+                        setClarifyText('');
+                      }}
+                    >
+                      填写含义
+                    </Button>
+                  )}
+                  {item.status === 'enabled' && (
+                    <Button
+                      size="sm"
+                      variant="ghost"
+                      disabled={busy}
+                      onClick={() => void doToggle(item, false)}
+                    >
+                      禁用
+                    </Button>
+                  )}
+                  {item.status === 'disabled' && (
+                    <Button
+                      size="sm"
+                      variant="ghost"
+                      disabled={busy}
+                      onClick={() => void doToggle(item, true)}
+                    >
+                      恢复使用
+                    </Button>
+                  )}
+                  {item.status !== 'revoked' && (
+                    <Button
+                      size="sm"
+                      variant="ghost"
+                      color="red.300"
+                      disabled={busy}
+                      onClick={() => void doRevoke(item)}
+                    >
+                      撤销这次学习
+                    </Button>
+                  )}
+                  {item.status === 'revoked' && (
+                    <Text fontSize="xs" color="whiteAlpha.600">
+                      已撤销：不再使用，也不能从同一段对话里重新学回。
+                    </Text>
+                  )}
+                </Flex>
+              )}
+            </Box>
+          )}
+        </Box>
+      ))}
+    </Box>
+  );
+}

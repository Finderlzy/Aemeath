+  meanings: { meaning: string; scenario?: string }[],
+): Promise<LearningActionResult> {
+  return request<LearningActionResult>('/learning/meanings', {
+    method: 'POST',
+    body: JSON.stringify({ item_id: itemId, meanings }),
+  });
+}

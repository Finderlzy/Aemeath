+
+function errorText(errors: FieldError[], fallback: string): string {
+  if (!errors || errors.length === 0) return fallback;
+  return errors.map((e) => `${e.field}：${e.message}`).join('；');
+}
+
+export default function DesktopPage(): JSX.Element {
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [loadError, setLoadError] = useState('');
+  const [readError, setReadError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [revision, setRevision] = useState('');
+
+  const [subtitleFontSize, setSubtitleFontSize] = useState('22');
+  const [subtitleMaxWidth, setSubtitleMaxWidth] = useState('520');
+  const [subtitleDwellMs, setSubtitleDwellMs] = useState('4000');
+  const [characterWidth, setCharacterWidth] = useState('420');
+  const [characterHeight, setCharacterHeight] = useState('620');
+  const [characterScale, setCharacterScale] = useState('1');
+
+  const apply = useCallback((data: any) => {
+    setSubtitleFontSize(String(data.subtitle_font_size));
+    setSubtitleMaxWidth(String(data.subtitle_max_width));
+    setSubtitleDwellMs(String(data.subtitle_dwell_ms));
+    setCharacterWidth(String(data.character_width));
+    setCharacterHeight(String(data.character_height));
+    setCharacterScale(String(data.character_scale));
+    setReadError(data.read_error ?? '');
+  }, []);

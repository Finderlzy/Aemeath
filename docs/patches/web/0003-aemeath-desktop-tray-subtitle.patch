+  const field = (
+    label: string,
+    value: string,
+    setValue: (next: string) => void,
+    range: readonly [number, number],
+    hint: string,
+  ) => (
+    <Box marginBottom="3" maxWidth="420px">
+      <Text fontSize="sm" marginBottom="1">{label}</Text>
+      <Input
+        value={value}
+        onChange={(e) => setValue(e.target.value)}

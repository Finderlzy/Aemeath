+    def _install_aemeath_proactive_generator(self) -> None:
+        """Give the Aemeath bridge a way to produce a proactive candidate.
+
+        The bridge decides *whether* Aemeath may speak; this supplies *what*
+        she says, using the same agent and system prompt as a normal reply. It
+        is installed here because this is the only place that holds both the
+        bridge and the initialized agent.
+
+        Without this the scheduler had no generator, so ``run_proactive`` was
+        only ever called by tests and the backend could never start a topic on
+        its own.
+        """
+        bridge = self.aemeath_bridge
+        agent = self.agent_engine
+        if bridge is None or agent is None:
+            return
+
+        # Imported lazily: these are the same input types a normal turn uses.
+        # They must come from the *same* module path the server itself loaded
+        # them under (``src.open_llm_vtuber.*``). Importing the bare
+        # ``open_llm_vtuber.*`` also resolves, because ``src/`` is on sys.path,
+        # but it executes the same file a second time and produces a second
+        # ``BatchInput`` class that the agent pipeline does not recognise.
+        from src.open_llm_vtuber.agent.input_types import (
+            BatchInput,
+            TextData,
+            TextSource,
+        )
+
+        async def _generate(is_startup: bool) -> str:
+            """Generate one proactive candidate through the real agent."""
+            prompt = await self._aemeath_proactive_prompt(is_startup)
+            batch = BatchInput(
+                texts=[TextData(source=TextSource.INPUT, content=prompt)],
+                metadata={"proactive_speak": True},
+            )
+            parts: list = []
+            async for item in agent.chat(batch):
+                text = getattr(getattr(item, "display_text", None), "text", None)
+                if text:
+                    parts.append(text)
+            return "".join(parts).strip()
+
+        bridge.set_proactive_generator(_generate)
+        logger.info("Aemeath proactive generator installed.")
+
+    async def _aemeath_proactive_prompt(self, is_startup: bool) -> str:
+        """Load the prompt that asks Aemeath to start a topic."""
+        name = "startup_greeting_prompt" if is_startup else "proactive_speak_prompt"
+        try:
+            from prompts import prompt_loader
+
+            prompt_file = self.system_config.tool_prompts.get(name)
+            if not prompt_file:
+                prompt_file = self.system_config.tool_prompts.get(
+                    "proactive_speak_prompt"
+                )
+            if prompt_file:
+                return prompt_loader.load_util(prompt_file)
+        except Exception as exc:
+            logger.warning("Could not load proactive prompt '{}': {}", name, exc)
+        return "Please say something."

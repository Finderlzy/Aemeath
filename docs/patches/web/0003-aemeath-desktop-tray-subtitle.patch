+
+// ---------------------------------------------------------------------------
+// Desktop and subtitle (V2-T03)
+// ---------------------------------------------------------------------------
+
+/**
+ * Desktop presentation settings.
+ *
+ * These are read by the character window to lay out the subtitle and by the
+ * management window to edit them, so both windows agree on size and timing
+ * without a second copy of the values.
+ */
+export interface DesktopSettings {
+  /** Subtitle font size in pixels. */
+  subtitle_font_size: number;
+  /** Maximum subtitle width in pixels; content wraps beyond it. */
+  subtitle_max_width: number;
+  /** How long one line stays after it finishes, in milliseconds. */
+  subtitle_dwell_ms: number;
+  /** Character window width in pixels. */
+  character_width: number;
+  /** Character window height in pixels. */
+  character_height: number;
+  /** Model scale multiplier inside the character window. */
+  character_scale: number;
+  /** Why the settings could not be read, when they could not. */
+  read_error: string;
+}
+
+/** Outcome of saving desktop settings. */
+export interface DesktopSaveResult {
+  ok: boolean;
+  errors: FieldError[];
+  conflict: boolean;
+  message: string;
+  saved_revision: string;
+  running_revision: string;
+  restart_required: boolean;
+}
+
+/** Read the desktop and subtitle settings. */
+export async function fetchDesktopSettings(): Promise<DesktopSettings> {
+  return request<DesktopSettings>('/desktop/settings');
+}
+
+/** Save the desktop and subtitle settings. */
+export async function saveDesktopSettings(input: {
+  subtitleFontSize: number;
+  subtitleMaxWidth: number;
+  subtitleDwellMs: number;
+  characterWidth: number;
+  characterHeight: number;
+  characterScale: number;
+  expectedRevision: string;
+}): Promise<DesktopSaveResult> {
+  return request<DesktopSaveResult>('/desktop/settings', {
+    method: 'POST',
+    body: JSON.stringify({
+      subtitle_font_size: input.subtitleFontSize,
+      subtitle_max_width: input.subtitleMaxWidth,
+      subtitle_dwell_ms: input.subtitleDwellMs,
+      character_width: input.characterWidth,
+      character_height: input.characterHeight,
+      character_scale: input.characterScale,
+      expected_revision: input.expectedRevision,
+    }),
+  });
+}

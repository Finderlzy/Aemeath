+/** Minimum and maximum accepted by the backend, shown next to each field. */
+const RANGES = {
+  subtitleFontSize: [10, 48],
+  subtitleMaxWidth: [160, 1600],
+  subtitleDwellMs: [500, 60000],
+  characterWidth: [200, 2000],
+  characterHeight: [200, 2000],
+  characterScale: [0.1, 4],

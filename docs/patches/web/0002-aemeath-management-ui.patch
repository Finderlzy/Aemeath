index 0000000..c6b033a
--- /dev/null
+++ b/src/renderer/src/components/aemeath/live2d-page.tsx
@@ -0,0 +1,292 @@
+/* eslint-disable @typescript-eslint/no-explicit-any */
+/**
+ * Live2D configuration page (v2 task V2-T02).
+ *
+ * The governing rule is that **a missing model is a state, not a blank page**
+ * (acceptance A6). There is no official Aemeath Live2D model yet, so on a fresh
+ * machine this page will usually have nothing to show. It must therefore:
+ *
+ * * explain what is missing and what to do about it, rather than rendering an
+ *   empty list that looks like a broken page;
+ * * keep the configuration editable anyway, so the user is not locked out of
+ *   the settings just because the assets are absent;
+ * * never present the bundled placeholder as her real model (V2-08).
+ *
+ * Scale and position are written to `model_dict.json`, which the renderer
+ * fetches; the selected model is written to the authoritative config. The page
+ * shows both locations so a user debugging a load failure can look in the right
+ * place.
+ */
+import { useCallback, useEffect, useState } from 'react';
+import { Box, Button, Heading, Input, Text } from '@chakra-ui/react';
+
+import {
+  fetchLive2D,
+  saveLive2D,
+  type Live2DModel,
+  type Live2DOverviewResponse,
+} from '../../services/aemeath-management';
+
+interface Notice {
+  kind: 'ok' | 'error' | 'info';
+  text: string;
+}
+
+const NOTICE_COLOR: Record<Notice['kind'], string> = {
+  ok: 'green.300',
+  error: 'red.300',
+  info: 'blue.200',
+};
+
+export default function Live2DPage(): JSX.Element {
+  const [data, setData] = useState<Live2DOverviewResponse | null>(null);
+  const [loadError, setLoadError] = useState('');
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const [selected, setSelected] = useState('');
+  const [scale, setScale] = useState('1');
+  const [xOffset, setXOffset] = useState('0');
+  const [yOffset, setYOffset] = useState('0');
+
+  const applyOverview = useCallback((overview: Live2DOverviewResponse) => {
+    setData(overview);
+    setSelected(overview.active_model);
+    setScale(String(overview.active?.scale ?? 1));
+    setXOffset(String(overview.active?.x_offset ?? 0));
+    setYOffset(String(overview.active?.y_offset ?? 0));
+  }, []);
+
+  const load = useCallback(async () => {
+    try {
+      applyOverview(await fetchLive2D());
+      setLoadError('');
+    } catch (error) {
+      setData(null);
+      setLoadError(error instanceof Error ? error.message : String(error));
+    }
+  }, [applyOverview]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const choose = (model: Live2DModel) => {
+    setSelected(model.name);
+    setScale(String(model.scale ?? 1));
+    setXOffset(String(model.x_offset ?? 0));
+    setYOffset(String(model.y_offset ?? 0));
+  };
+
+  const save = async () => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await saveLive2D({
+        modelName: selected,
+        scale: Number(scale),
+        xOffset: Number(xOffset),
+        yOffset: Number(yOffset),
+        expectedRevision: '',
+      });
+      if (result.ok) {
+        setNotice({
+          kind: 'ok',
+          text: '已保存。角色窗口重新加载后使用新的模型与位置。',
+        });
+      } else {
+        setNotice({ kind: 'error', text: result.error || '保存失败。' });
+      }
+      await load();
+    } catch (error) {
+      setNotice({
+        kind: 'error',
+        text: error instanceof Error ? error.message : String(error),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const hasModels = Boolean(data?.models.length);
+
+  return (
+    <Box maxWidth="900px">
+      <Heading size="md" marginBottom="2">
+        Live2D 与桌面
+      </Heading>
+      <Text fontSize="sm" color="whiteAlpha.800" marginBottom="4">
+        选择角色模型并调整比例与位置。缺模型不影响聊天、语音与字幕。
+      </Text>
+
+      {loadError && (
+        <Box
+          background="red.900"
+          borderWidth="1px"
+          borderColor="red.400"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">无法读取 Live2D 配置</Text>
+          <Text fontSize="sm">{loadError}</Text>
+          <Button size="sm" marginTop="2" onClick={() => void load()}>
+            重试
+          </Button>
+        </Box>
+      )}
+
+      {notice && (
+        <Box
+          background="blackAlpha.400"
+          borderWidth="1px"
+          borderColor={NOTICE_COLOR[notice.kind]}
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontSize="sm">{notice.text}</Text>
+        </Box>
+      )}
+
+      {/*
+        A missing or unusable model is stated here, in the page body, so the
+        user always gets an explanation. The form below stays rendered either
+        way — being unable to see the model is not a reason to be unable to
+        configure it.
+      */}
+      {data && !data.ok && data.error && (
+        <Box
+          background="orange.900"
+          borderWidth="1px"
+          borderColor="orange.300"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">模型不可用</Text>
+          <Text fontSize="sm">{data.error}</Text>
+          <Text fontSize="xs" marginTop="1" color="whiteAlpha.800">
+            聊天、语音和字幕仍然可用；只有角色形象无法显示。
+          </Text>
+        </Box>
+      )}
+
+      {data && data.ok && !data.active_model_available && data.active_model && (
+        <Box
+          background="orange.900"
+          borderWidth="1px"
+          borderColor="orange.300"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontSize="sm">
+            当前配置的模型「{data.active_model}」在本机没有找到资源。
+          </Text>
+        </Box>
+      )}
+
+      <Heading size="sm" marginBottom="2">
+        已安装的模型
+      </Heading>
+
+      {data && !hasModels && (
+        <Box
+          borderWidth="1px"
+          borderColor="whiteAlpha.300"
+          borderRadius="md"
+          padding="3"
+          marginBottom="4"
+        >
+          <Text fontSize="sm">本机还没有可用的 Live2D 模型。</Text>
+          <Text fontSize="xs" color="whiteAlpha.700" marginTop="1">
+            把包含 .model3.json 的模型目录放到模型目录后刷新本页：
+          </Text>
+          <Text fontSize="xs" color="whiteAlpha.600" marginTop="1">
+            {data.models_root}
+          </Text>
+        </Box>
+      )}
+
+      {data?.models.map((model) => (
+        <Box
+          key={model.name}
+          borderWidth="1px"
+          borderColor={selected === model.name ? 'green.300' : 'whiteAlpha.300'}
+          borderRadius="md"
+          padding="3"
+          marginBottom="2"
+          cursor="pointer"
+          onClick={() => choose(model)}
+        >
+          <Text fontSize="sm" fontWeight="bold">
+            {model.label || model.name}
+          </Text>
+          {model.is_placeholder && (
+            <Text fontSize="xs" color="orange.200">
+              示例模型，不是爱弥斯的正式模型
+            </Text>
+          )}
+          {model.description && (
+            <Text fontSize="xs" color="whiteAlpha.700" marginTop="1">
+              {model.description}
+            </Text>
+          )}
+          <Text fontSize="xs" color="whiteAlpha.600" marginTop="1">
+            比例 {model.scale}，水平 {model.x_offset}，垂直 {model.y_offset}
+          </Text>
+        </Box>
+      ))}
+
+      {data && (
+        <Box marginTop="4">
+          <Heading size="sm" marginBottom="2">
+            比例与位置
+          </Heading>
+
+          <Text fontSize="sm" marginBottom="1">
+            比例
+          </Text>
+          <Input
+            value={scale}
+            onChange={(e) => setScale(e.target.value)}
+            marginBottom="3"
+          />
+
+          <Text fontSize="sm" marginBottom="1">
+            水平偏移
+          </Text>
+          <Input
+            value={xOffset}
+            onChange={(e) => setXOffset(e.target.value)}
+            marginBottom="3"
+          />
+
+          <Text fontSize="sm" marginBottom="1">
+            垂直偏移
+          </Text>
+          <Input
+            value={yOffset}
+            onChange={(e) => setYOffset(e.target.value)}
+            marginBottom="3"
+          />
+
+          <Text fontSize="xs" color="whiteAlpha.600" marginBottom="3">
+            模型目录：{data.models_root}
+            <br />
+            模型字典：{data.model_dict_path}
+          </Text>
+
+          <Button
+            colorPalette="blue"
+            disabled={busy || !selected || !hasModels}
+            onClick={() => void save()}
+          >
+            保存
+          </Button>
+        </Box>
+      )}
+    </Box>
+  );
+}
diff --git a/src/renderer/src/components/aemeath/manage-page.tsx b/src/renderer/src/components/aemeath/manage-page.tsx

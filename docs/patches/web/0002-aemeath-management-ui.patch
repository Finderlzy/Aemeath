+/**
+ * Whether this window is the management UI rather than the character.
+ *
+ * The management window must not mount the conversation stack: doing so would
+ * open a second WebSocket session, a second microphone and a second audio
+ * output for the same character. Selecting the page before any provider mounts
+ * is what guarantees the two windows stay independent.
+ */
+function isManagementWindow(): boolean {
+  if (typeof window === "undefined") return false;
+  const { pathname, hash, search } = window.location;

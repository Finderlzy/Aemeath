+/**
+ * 黑话词典 page (v2 task V2-T04).
+ *
+ * Shows words that mean something specific between the user and Aemeath.
+ * A word may carry several meanings at once: the design forbids resolving
+ * ambiguity by overwriting an earlier sense, so each meaning is listed, and a
+ * word whose meaning could not be settled is flagged for the user to fill in.
+ */
+import LearningPage from './learning-page';
+
+export default function JargonPage(): JSX.Element {
+  return (
+    <LearningPage
+      kind="jargon"
+      title="黑话词典"
+      description="爱弥斯学到的、在你这里具有特殊含义的词与说法。"
+      contentLabel="词语"
+    />
+  );
+}
diff --git a/src/renderer/src/components/aemeath/learning-page.tsx b/src/renderer/src/components/aemeath/learning-page.tsx

+  return (
+    <Box maxWidth="820px">
+      <Heading size="md" marginBottom="2">
+        桌面与字幕
+      </Heading>
+      <Text fontSize="sm" color="whiteAlpha.800" marginBottom="4">
+        字幕位于角色下方、任务栏上方，保持一行。角色窗口默认停在所在显示器的右下角，
+        显示器移除后会回到可见区域。
+      </Text>
+
+      {loadError && (
+        <Box
+          background="red.900"
+          borderWidth="1px"
+          borderColor="red.400"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">无法读取桌面设置</Text>
+          <Text fontSize="sm">{loadError}</Text>
+          <Button size="sm" marginTop="2" onClick={() => void load()}>
+            重试
+          </Button>
+        </Box>
+      )}
+
+      {/*
+        A config that cannot be parsed is reported here rather than silently
+        showing defaults: the values below would then be a guess, not settings.
+      */}
+      {readError && (
+        <Box
+          background="orange.900"
+          borderWidth="1px"
+          borderColor="orange.300"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">配置文件读取异常</Text>
+          <Text fontSize="sm">{readError}</Text>
+          <Text fontSize="xs" marginTop="1" color="whiteAlpha.800">
+            下面显示的是默认值，尚未写入你的配置。
+          </Text>
+        </Box>
+      )}
+
+      {notice && (
+        <Box
+          background="blackAlpha.400"
+          borderWidth="1px"
+          borderColor={NOTICE_COLOR[notice.kind]}
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontSize="sm">{notice.text}</Text>
+        </Box>
+      )}
+
+      <Heading size="sm" marginBottom="2">字幕</Heading>
+      {field('字号', subtitleFontSize, setSubtitleFontSize, RANGES.subtitleFontSize,
+        '像素。以实际可读性为准')}
+      {field('最大宽度', subtitleMaxWidth, setSubtitleMaxWidth, RANGES.subtitleMaxWidth,
+        '像素。超出后按短句接续')}
+      {field('停留时间', subtitleDwellMs, setSubtitleDwellMs, RANGES.subtitleDwellMs,
+        '毫秒。一行说完后保留的时间')}
+
+      <Heading size="sm" marginTop="5" marginBottom="2">角色窗口</Heading>
+      {field('宽度', characterWidth, setCharacterWidth, RANGES.characterWidth,
+        '像素（Windows 缩放下的逻辑尺寸）')}
+      {field('高度', characterHeight, setCharacterHeight, RANGES.characterHeight,
+        '像素（Windows 缩放下的逻辑尺寸）')}
+      {field('模型缩放', characterScale, setCharacterScale, RANGES.characterScale,
+        '窗口内模型的缩放倍数')}
+
+      <Flex gap="3" marginTop="4">
+        <Button
+          colorPalette="blue"
+          disabled={busy || Boolean(loadError)}
+          onClick={() => void handleSave()}
+        >
+          保存
+        </Button>
+        <Button variant="ghost" disabled={busy} onClick={() => void load()}>
+          重新读取
+        </Button>
+      </Flex>
+    </Box>
+  );
+}

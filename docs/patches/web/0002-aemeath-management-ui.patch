@@ -0,0 +1,208 @@
+/**
+ * Aemeath management API client.
+ *
+ * The management surface is the Aemeath FastAPI routes mounted at
+ * `/aemeath/manage/`, **not** the chat WebSocket. It is deliberately a separate
+ * transport:
+ *
+ * - configuration is read and written by HTTP, so the management page works
+ *   while the character session is closed or reconnecting;
+ * - nothing here touches the conversation bridge, so opening the page cannot
+ *   start a second session or a second microphone.
+ *
+ * Field names come from the backend response. There is no second copy of the
+ * contract here; the request bodies only carry what the schemas accept.
+ */
+
+/** A single rejected field, addressed for the UI to focus. */
+export interface FieldError {
+  field: string;
+  message: string;
+}
+
+/** Result of a save attempt. */
+export interface SaveResult {
+  ok: boolean;
+  errors: FieldError[];
+  conflict: boolean;
+  message: string;
+  saved_revision: string;
+  running_revision: string;
+  restart_required: boolean;
+}
+
+/** Conversation model connection. No key value is ever returned. */
+export interface ModelOverview {
+  provider: string;
+  base_url: string;
+  model: string;
+  api_key_configured: boolean;
+  api_key_env: string;
+}
+
+/** Persona as configured, with the legacy text preserved. */
+export interface PersonaOverview {
+  mode: 'legacy' | 'split';
+  identity: string;
+  personality: string;
+  reply_style: string;
+  legacy_prompt: string;
+  active_prompt: string;
+}
+
+/** Everything the overview page shows. */
+export interface OverviewResponse {
+  config_path: string;
+  saved_revision: string;
+  running_revision: string;
+  restart_required: boolean;
+  model: ModelOverview;
+  persona: PersonaOverview;
+  read_error: string;
+}
+
+/** Base path of the management routes. */
+export const MANAGEMENT_BASE = '/aemeath/manage';
+
+/**
+ * Resolve the management API origin.
+ *
+ * In the browser the page is served by the same backend that hosts the routes,
+ * so a relative URL is correct and keeps the loopback restriction satisfied.
+ * Electron loads the renderer from `file://`, where a relative URL has no host;
+ * the backend address is used instead.
+ */
+function managementBaseUrl(): string {
+  if (typeof window !== 'undefined' && window.location.protocol.startsWith('http')) {
+    return MANAGEMENT_BASE;
+  }
+  return `http://127.0.0.1:12393${MANAGEMENT_BASE}`;
+}
+
+/** Error carrying the HTTP status so callers can distinguish a conflict. */
+export class ManagementError extends Error {
+  status: number;
+  payload: SaveResult | null;
+
+  constructor(message: string, status: number, payload: SaveResult | null = null) {
+    super(message);
+    this.name = 'ManagementError';
+    this.status = status;
+    this.payload = payload;
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`${managementBaseUrl()}${path}`, {
+      headers: { 'Content-Type': 'application/json' },
+      ...init,
+    });
+  } catch (error) {
+    // A transport failure is reported as its own case: "the backend is not
+    // running" must not be shown as a validation problem in the form.
+    throw new ManagementError(
+      `无法连接管理服务：${error instanceof Error ? error.message : String(error)}`,
+      0,
+      null,
+    );
+  }
+
+  const text = await response.text();
+  let data: unknown = null;
+  try {
+    data = text ? JSON.parse(text) : null;
+  } catch {
+    throw new ManagementError('管理服务返回了无法解析的内容。', response.status, null);
+  }
+
+  if (!response.ok) {
+    const payload = (data ?? null) as SaveResult | null;
+    const message =
+      (payload && payload.message) ||
+      (payload && payload.errors?.length ? payload.errors[0].message : '') ||
+      `请求失败（HTTP ${response.status}）`;
+    throw new ManagementError(message, response.status, payload);
+  }
+
+  return data as T;
+}
+
+/** Read the current model, persona and revision state. */
+export async function fetchOverview(): Promise<OverviewResponse> {
+  return request<OverviewResponse>('/overview');
+}
+
+/**
+ * Save the conversation model connection.
+ *
+ * `expectedRevision` is required by the backend; omitting it would let this
+ * client overwrite a change made elsewhere.
+ */
+export async function saveModel(input: {
+  baseUrl: string;
+  model: string;
+  apiKey?: string;
+  expectedRevision: string;
+}): Promise<SaveResult> {
+  return request<SaveResult>('/model', {
+    method: 'POST',
+    body: JSON.stringify({
+      base_url: input.baseUrl,
+      model: input.model,
+      api_key: input.apiKey || null,
+      expected_revision: input.expectedRevision,
+    }),
+  });
+}
+
+/** Save the three persona fields. */
+export async function savePersona(input: {
+  identity: string;
+  personality: string;
+  replyStyle: string;
+  expectedRevision: string;
+}): Promise<SaveResult> {
+  return request<SaveResult>('/persona', {
+    method: 'POST',
+    body: JSON.stringify({
+      identity: input.identity,
+      personality: input.personality,
+      reply_style: input.replyStyle,
+      expected_revision: input.expectedRevision,
+    }),
+  });
+}
+
+/**
+ * Whether a change is saved but not yet adopted by the running service.
+ *
+ * Kept as one function so every screen answers the question the same way: a
+ * successful save is not the same thing as a running change.
+ */
+export function describeEffectState(overview: OverviewResponse): {
+  label: string;
+  detail: string;
+  pending: boolean;
+} {
+  if (overview.read_error) {
+    return {
+      label: '读取失败',
+      detail: overview.read_error,
+      pending: false,
+    };
+  }
+  if (overview.restart_required) {
+    return {
+      label: '已保存，尚未生效',
+      detail: '配置已写入本地文件，重启 Aemeath 后生效。',
+      pending: true,
+    };
+  }
+  return {
+    label: '已生效',
+    detail: '运行中的服务正在使用当前配置。',
+    pending: false,
+  };
+}

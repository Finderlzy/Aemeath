index 0000000..a16369f
--- /dev/null
+++ b/src/renderer/src/context/aemeath-context.tsx
@@ -0,0 +1,206 @@
+/* eslint-disable react/jsx-no-constructed-context-values */
+/**
+ * Aemeath controls: mode, switches, screen request and typing activity.
+ *
+ * These are the client half of the bridge contract. Every action here sends a
+ * message the backend routes through the bridge, so no client control can
+ * bypass the coordinator.
+ */
+import React, {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+} from 'react';
+import { useWebSocket } from '@/context/websocket-context';
+import {
+  AEMEATH_PROTOCOL_VERSION,
+  AemeathState,
+  aemeathProtocol,
+} from '@/services/aemeath-protocol';
+
+interface AemeathContextProps {
+  /** Whether the backend accepted this client as a full Aemeath client. */
+  negotiated: boolean;
+  /** Latest situation state reported by the backend. */
+  state: AemeathState | null;
+  /** Whether the client is showing text for a turn. */
+  setMode: (mode: 'normal' | 'class') => void;
+  setSwitch: (name: 'microphone' | 'screen' | 'proactive', enabled: boolean) => void;
+  requestScreen: () => void;
+  /** Report whether the user is typing, used by the proactive rules. */
+  reportTyping: (typing: boolean) => void;
+  /** Report whether the microphone is capturing. */
+  reportVoiceActivity: (active: boolean) => void;
+  requestMemories: () => void;
+  forgetMemory: (memoryId: string, fragments?: string[]) => void;
+}
+
+const noop = () => {};
+
+export const AemeathContext = createContext<AemeathContextProps>({
+  negotiated: false,
+  state: null,
+  setMode: noop,
+  setSwitch: noop,
+  requestScreen: noop,
+  reportTyping: noop,
+  reportVoiceActivity: noop,
+  requestMemories: noop,
+  forgetMemory: noop,
+});
+
+export function useAemeath() {
+  return useContext(AemeathContext);
+}
+
+/** How long typing must stop before activity is reported as ended. */
+const TYPING_IDLE_MS = 1200;
+
+export function AemeathProvider({ children }: { children: React.ReactNode }) {
+  const { sendMessage, wsState } = useWebSocket();
+  const [state, setState] = useState<AemeathState | null>(null);
+  const [negotiated, setNegotiated] = useState(false);
+  const typingTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const typingReported = useRef(false);
+
+  // Mirror protocol state into React state for rendering. The protocol object
+  // itself stays the source of truth for the audio path, which reads it
+  // synchronously.
+  useEffect(() => {
+    const interval = setInterval(() => {
+      setNegotiated(aemeathProtocol.negotiated);
+    }, 500);
+    return () => clearInterval(interval);
+  }, []);
+
+  // Ask the backend for the current state whenever the connection opens, so a
+  // reconnect does not leave the UI showing a stale mode.
+  useEffect(() => {
+    if (wsState === 'OPEN') {
+      sendMessage({
+        type: 'aemeath-hello',
+        protocol_version: AEMEATH_PROTOCOL_VERSION,
+      });
+    }
+  }, [wsState, sendMessage]);
+
+  const setMode = useCallback(
+    (mode: 'normal' | 'class') => {
+      // Optimistically mark every turn cancelled: the backend confirms with a
+      // clear-audio frame, but audio must stop immediately, not one round trip
+      // later.
+      aemeathProtocol.cancelAllTurns();
+      sendMessage({ type: 'aemeath-set-mode', mode });
+    },
+    [sendMessage],
+  );
+
+  const setSwitch = useCallback(
+    (name: 'microphone' | 'screen' | 'proactive', enabled: boolean) => {
+      sendMessage({ type: 'aemeath-set-switch', switch: name, enabled });
+    },
+    [sendMessage],
+  );
+
+  const requestScreen = useCallback(() => {
+    sendMessage({ type: 'aemeath-screen-request', force: true });
+  }, [sendMessage]);
+
+  const reportTyping = useCallback(
+    (typing: boolean) => {
+      if (typing) {
+        if (!typingReported.current) {
+          typingReported.current = true;
+          sendMessage({ type: 'aemeath-activity', typing: true });
+        }
+        if (typingTimer.current) clearTimeout(typingTimer.current);
+        typingTimer.current = setTimeout(() => {
+          typingReported.current = false;
+          sendMessage({ type: 'aemeath-activity', typing: false });
+        }, TYPING_IDLE_MS);
+        return;
+      }
+      if (typingTimer.current) clearTimeout(typingTimer.current);
+      if (typingReported.current) {
+        typingReported.current = false;
+        sendMessage({ type: 'aemeath-activity', typing: false });
+      }
+    },
+    [sendMessage],
+  );
+
+  const reportVoiceActivity = useCallback(
+    (active: boolean) => {
+      sendMessage({ type: 'aemeath-activity', voice_active: active });
+    },
+    [sendMessage],
+  );
+
+  const requestMemories = useCallback(() => {
+    sendMessage({ type: 'aemeath-memory-query', action: 'list' });
+  }, [sendMessage]);
+
+  const forgetMemory = useCallback(
+    (memoryId: string, fragments?: string[]) => {
+      sendMessage({
+        type: 'aemeath-memory-query',
+        action: 'forget',
+        memory_id: memoryId,
+        fragments,
+      });
+    },
+    [sendMessage],
+  );
+
+  // Keep the rendered state in step with the protocol object.
+  useEffect(() => {
+    const interval = setInterval(() => {
+      setState((previous) => {
+        const next: AemeathState = {
+          mode: aemeathProtocol.mode,
+          state_version: aemeathProtocol.stateVersion,
+          microphone_enabled: previous?.microphone_enabled ?? false,
+          screen_observation_enabled: previous?.screen_observation_enabled ?? false,
+          proactive_enabled: previous?.proactive_enabled ?? false,
+          user_paused: previous?.user_paused ?? false,
+          voice_allowed: aemeathProtocol.voiceAllowed,
+        };
+        return next;
+      });
+    }, 500);
+    return () => clearInterval(interval);
+  }, []);
+
+  const value = useMemo(
+    () => ({
+      negotiated,
+      state,
+      setMode,
+      setSwitch,
+      requestScreen,
+      reportTyping,
+      reportVoiceActivity,
+      requestMemories,
+      forgetMemory,
+    }),
+    [
+      negotiated,
+      state,
+      setMode,
+      setSwitch,
+      requestScreen,
+      reportTyping,
+      reportVoiceActivity,
+      requestMemories,
+      forgetMemory,
+    ],
+  );
+
+  return (
+    <AemeathContext.Provider value={value}>{children}</AemeathContext.Provider>
+  );
+}

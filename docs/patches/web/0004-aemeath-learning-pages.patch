+/**
+ * 表达学习 page (v2 task V2-T04).
+ *
+ * Shows how the user phrases things, learned from conversation. The heavy
+ * lifting is in `learning-page.tsx`, shared with the jargon page: both are the
+ * same store filtered by `kind`, and duplicating the candidate/revoke logic
+ * would let the two pages drift apart.
+ */
+import LearningPage from './learning-page';
+
+export default function ExpressionPage(): JSX.Element {
+  return (
+    <LearningPage
+      kind="expression"
+      title="表达学习"
+      description="爱弥斯从你们的对话里学到的说法、口头语和语气习惯。"
+      contentLabel="表达方式"
+    />
+  );
+}

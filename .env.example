# Aemeath 环境变量样例（可以提交；真实密钥放 `.env`，已被 .gitignore 排除）
#
# 用途：说明有哪些变量、各自从哪来。**这里只写变量名和假值，绝不写真实密钥。**
# 本机验收环境的实际注入见 `scripts/acceptance-env.ps1`（不入版本管理）。

# --- 对话模型（真实供应商 DeepSeek，OpenAI 兼容接口）---
# 配置里写 `${AEMEATH_LLM_API_KEY}`，运行前必须设置，否则对话端点会明确报错。
# 本机来源：DSH 凭据库 `D:\Program Files\DeepSeek Harness\data\.credentials.yaml`
#          中的 `DEEPSEEK_API_KEY`。
AEMEATH_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 记忆提取（默认复用对话密钥）
AEMEATH_EXTRACTION_API_KEY=

# --- 本地嵌入 LM Studio（OpenAI 兼容，不做真实鉴权）---
AEMEATH_EMBEDDING_API_KEY=lm-studio

# --- 视觉 EasyCLIProxyAPI（仅本机回环鉴权）---
AEMEATH_VISION_API_KEY=

# --- 语音 ---
AEMEATH_TTS_API_KEY=
AEMEATH_GPT_SOVITS_REF_AUDIO=
AEMEATH_GPT_SOVITS_PROMPT_TEXT=

# --- 本机代理与 TLS（仅限本机验收）---
# 外网必须走本机代理；httpx 不读 Windows 系统代理，需显式设置。
AEMEATH_PROXY=http://127.0.0.1:7897
# 本机代理使用自签 CA。设为 1 会对**对话端点**关闭校验并打 warning，
# 仅限本机验收，不要用于正式部署。
AEMEATH_TLS_INSECURE=1
NO_PROXY=127.0.0.1,localhost

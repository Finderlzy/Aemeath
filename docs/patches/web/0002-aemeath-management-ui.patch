index 0000000..aacd81f
--- /dev/null
+++ b/src/renderer/src/components/aemeath/memory-page.tsx
@@ -0,0 +1,512 @@
+/* eslint-disable @typescript-eslint/no-explicit-any */
+/**
+ * Memory management page (v2 task V2-T02).
+ *
+ * Three rules from the acceptance criteria shape this screen:
+ *
+ * 1. **"No memories" and "search is broken" are different things.** The backend
+ *    reports `available` separately from `ok`; this page renders an unavailable
+ *    index as a stated failure with a retry, never as an empty list. Showing a
+ *    retrieval outage as "you have no memories" is the specific confusion the
+ *    criterion forbids.
+ * 2. **The impact of a removal is shown before it happens.** `delete_memory()`
+ *    cascades into the source messages while a precise `forget()` removes only
+ *    the located span. The page fetches the impact first and, when the wider
+ *    operation is the only one available, requires an explicit confirmation
+ *    instead of quietly deleting more than the user asked for.
+ * 3. **A removal that did not happen is not reported as done.** When the span
+ *    cannot be located the backend returns `needs_selection`; the page shows
+ *    the source messages and explains that nothing was removed.
+ *
+ * Restoring a backup warns first, because a backup taken before a forgetting
+ * can bring that content back.
+ */
+import { useCallback, useEffect, useState } from 'react';
+import { Box, Button, Flex, Heading, Input, Text, Textarea } from '@chakra-ui/react';
+
+import {
+  correctMemory,
+  fetchBackups,
+  fetchMemories,
+  fetchMemoryImpact,
+  forgetMemory,
+  restoreBackup,
+  ManagementError,
+  searchMemories,
+  type BackupEntry,
+  type MemoryImpact,
+  type MemoryItemView,
+  type MemoryListResponse,
+  type MemorySource,
+} from '../../services/aemeath-management';
+
+interface Notice {
+  kind: 'ok' | 'error' | 'info';
+  text: string;
+}
+
+const NOTICE_COLOR: Record<Notice['kind'], string> = {
+  ok: 'green.300',
+  error: 'red.300',
+  info: 'blue.200',
+};
+
+export default function MemoryPage(): JSX.Element {
+  const [query, setQuery] = useState('');
+  const [listing, setListing] = useState<MemoryListResponse | null>(null);
+  const [loadError, setLoadError] = useState('');
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const [editingId, setEditingId] = useState('');
+  const [editText, setEditText] = useState('');
+
+  const [impact, setImpact] = useState<MemoryImpact | null>(null);
+  const [impactFor, setImpactFor] = useState('');
+  const [selection, setSelection] = useState<MemorySource[]>([]);
+  const [selectionFor, setSelectionFor] = useState('');
+
+  const [backups, setBackups] = useState<BackupEntry[]>([]);
+  const [restoreWarning, setRestoreWarning] = useState('');
+
+  /**
+   * Load memories.
+   *
+   * A load failure is held separately from the listing so the two states can be
+   * rendered differently: an empty list from a working search is a result, an
+   * error is not.
+   */
+  const load = useCallback(async (text: string) => {
+    try {
+      const data = text.trim()
+        ? await searchMemories(text)
+        : await fetchMemories();
+      setListing(data);
+      setLoadError('');
+    } catch (error) {
+      setListing(null);
+      setLoadError(error instanceof Error ? error.message : String(error));
+    }
+  }, []);
+
+  const loadBackups = useCallback(async () => {
+    try {
+      const data = await fetchBackups();
+      setBackups(data.backups ?? []);
+    } catch {
+      // A missing backup list is not an error worth a banner; the panel simply
+      // shows that there are none.
+      setBackups([]);
+    }
+  }, []);
+
+  useEffect(() => {
+    void load('');
+    void loadBackups();
+  }, [load, loadBackups]);
+
+  const run = async (action: () => Promise<any>, successText: string, after?: () => void) => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await action();
+      if (result?.ok) {
+        setNotice({ kind: 'ok', text: successText });
+        after?.();
+      } else {
+        setNotice({ kind: 'error', text: result?.error || '操作失败。' });
+      }
+      // `needs_selection` means nothing was removed; surface it rather than
+      // treating the call as a completed removal.
+      if (result && !result.ok && result.needs_selection?.length) {
+        setSelection(result.needs_selection);
+      }
+      await load(query);
+    } catch (error) {
+      const payload = error instanceof ManagementError ? error.payload : null;
+      if (payload && (payload as any).needs_selection?.length) {
+        setSelection((payload as any).needs_selection);
+      }
+      if (payload && (payload as any).impact) {
+        setImpact((payload as any).impact);
+      }
+      setNotice({
+        kind: 'error',
+        text: error instanceof Error ? error.message : String(error),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const startForget = async (item: MemoryItemView) => {
+    setImpact(null);
+    setImpactFor(item.memory_id);
+    setSelection([]);
+    try {
+      setImpact(await fetchMemoryImpact(item.memory_id));
+    } catch (error) {
+      setNotice({
+        kind: 'error',
+        text: error instanceof Error ? error.message : String(error),
+      });
+    }
+  };
+
+  const doForget = async (item: MemoryItemView, confirmCascading: boolean) => {
+    await run(
+      () => forgetMemory(item.memory_id, { confirmCascading }),
+      '已遗忘这条记忆。',
+      () => {
+        setImpact(null);
+        setImpactFor('');
+        setSelection([]);
+      },
+    );
+  };
+
+  const doCorrect = async (item: MemoryItemView) => {
+    const text = editText.trim();
+    if (!text) {
+      setNotice({ kind: 'error', text: '记忆内容不能为空。' });
+      return;
+    }
+    await run(() => correctMemory(item.memory_id, text), '已纠正，新内容会用于后续对话。', () => {
+      setEditingId('');
+      setEditText('');
+    });
+  };
+
+  const doRestore = async (backup: BackupEntry, confirm: boolean) => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await restoreBackup(backup.path, confirm);
+      if (result.ok) {
+        setNotice({ kind: 'ok', text: '已恢复备份。重启 Aemeath 后生效。' });
+        setRestoreWarning('');
+      } else if (result.requires_confirmation) {
+        // Show the warning and require an explicit second click; the restore
+        // has not run.
+        setRestoreWarning(result.warning || '恢复备份前需要确认。');
+        setNotice({ kind: 'info', text: '请确认下方提示后再执行恢复。' });
+      } else {
+        setNotice({ kind: 'error', text: result.error || '恢复失败。' });
+      }
+      await load(query);
+    } catch (error) {
+      setNotice({
+        kind: 'error',
+        text: error instanceof Error ? error.message : String(error),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const unavailable = listing !== null && !listing.ok;
+
+  return (
+    <Box maxWidth="900px">
+      <Heading size="md" marginBottom="2">
+        记忆
+      </Heading>
+      <Text fontSize="sm" color="whiteAlpha.800" marginBottom="4">
+        查看、搜索、纠正和遗忘本地记忆。记忆保存在本机数据库中。
+      </Text>
+
+      {notice && (
+        <Box
+          background="blackAlpha.400"
+          borderWidth="1px"
+          borderColor={NOTICE_COLOR[notice.kind]}
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontSize="sm">{notice.text}</Text>
+        </Box>
+      )}
+
+      {loadError && (
+        <Box
+          background="red.900"
+          borderWidth="1px"
+          borderColor="red.400"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">无法读取记忆</Text>
+          <Text fontSize="sm">{loadError}</Text>
+          <Button size="sm" marginTop="2" onClick={() => void load(query)}>
+            重试
+          </Button>
+        </Box>
+      )}
+
+      <Flex marginBottom="3">
+        <Input
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+          placeholder="按含义搜索，留空显示全部"
+          marginRight="2"
+          onKeyDown={(e) => {
+            if (e.key === 'Enter') void load(query);
+          }}
+        />
+        <Button colorPalette="blue" disabled={busy} onClick={() => void load(query)}>
+          搜索
+        </Button>
+      </Flex>
+
+      {unavailable && listing && (
+        <Box
+          background="orange.900"
+          borderWidth="1px"
+          borderColor="orange.300"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">检索不可用，这不是「没有记忆」</Text>
+          <Text fontSize="sm">{listing.error}</Text>
+          <Text fontSize="xs" marginTop="1" color="whiteAlpha.800">
+            下面列出的记忆来自本地数据库，仍然可以查看、纠正或遗忘；
+            按含义搜索需要先配置嵌入模型。
+          </Text>
+        </Box>
+      )}
+
+      {listing && listing.ok && listing.memories.length === 0 && (
+        <Text fontSize="sm" color="whiteAlpha.700" marginBottom="4">
+          {query.trim() ? '没有匹配的记忆。' : '还没有记住任何内容。'}
+        </Text>
+      )}
+
+      {listing?.memories.map((item) => (
+        <Box
+          key={item.memory_id}
+          borderWidth="1px"
+          borderColor="whiteAlpha.300"
+          borderRadius="md"
+          padding="3"
+          marginBottom="3"
+        >
+          {editingId === item.memory_id ? (
+            <Box>
+              <Textarea
+                value={editText}
+                onChange={(e) => setEditText(e.target.value)}
+                rows={3}
+                marginBottom="2"
+              />
+              <Button
+                size="sm"
+                colorPalette="blue"
+                marginRight="2"
+                disabled={busy}
+                onClick={() => void doCorrect(item)}
+              >
+                保存纠正
+              </Button>
+              <Button size="sm" variant="ghost" onClick={() => setEditingId('')}>
+                取消
+              </Button>
+            </Box>
+          ) : (
+            <Box>
+              <Text fontSize="sm" whiteSpace="pre-wrap">
+                {item.content}
+              </Text>
+              <Text fontSize="xs" color="whiteAlpha.600" marginTop="1">
+                {item.kind === 'experience' ? '经历' : '事实'}
+                {item.valid ? '' : '（已被替代，不再参与检索）'}
+                {item.superseded_by ? ` → ${item.superseded_by.slice(0, 8)}` : ''}
+              </Text>
+
+              {item.sources.length > 0 && (
+                <Box marginTop="2">
+                  <Text fontSize="xs" color="whiteAlpha.700">
+                    来源消息：
+                  </Text>
+                  {item.sources.map((source) => (
+                    <Text
+                      key={source.message_id}
+                      fontSize="xs"
+                      color="whiteAlpha.600"
+                      whiteSpace="pre-wrap"
+                    >
+                      · {source.content || '（消息已删除）'}
+                    </Text>
+                  ))}
+                </Box>
+              )}
+
+              {impactFor === item.memory_id && impact && (
+                <Box
+                  background="blackAlpha.400"
+                  borderWidth="1px"
+                  borderColor={impact.removes_source_messages ? 'orange.300' : 'whiteAlpha.300'}
+                  padding="2"
+                  marginTop="2"
+                  borderRadius="md"
+                >
+                  <Text fontSize="xs">{impact.message}</Text>
+                  {impact.removes_source_messages && (
+                    <Text fontSize="xs" color="orange.200" marginTop="1">
+                      这会删除 {impact.affected_message_ids.length} 条来源消息及其中的其他内容。
+                    </Text>
+                  )}
+                  <Flex marginTop="2">
+                    <Button
+                      size="xs"
+                      colorPalette={impact.removes_source_messages ? 'red' : 'blue'}
+                      marginRight="2"
+                      disabled={busy}
+                      onClick={() => void doForget(item, impact.removes_source_messages)}
+                    >
+                      {impact.removes_source_messages ? '确认连带删除并遗忘' : '确认遗忘'}
+                    </Button>
+                    <Button
+                      size="xs"
+                      variant="ghost"
+                      onClick={() => {
+                        setImpactFor('');
+                        setImpact(null);
+                      }}
+                    >
+                      取消
+                    </Button>
+                  </Flex>
+                </Box>
+              )}
+
+              {selectionFor === item.memory_id && selection.length > 0 && (
+                <Box
+                  background="blackAlpha.400"
+                  borderWidth="1px"
+                  borderColor="orange.300"
+                  padding="2"
+                  marginTop="2"
+                  borderRadius="md"
+                >
+                  <Text fontSize="xs" fontWeight="bold">
+                    这条记忆没有可定位的原文片段，尚未删除任何内容
+                  </Text>
+                  <Text fontSize="xs" marginTop="1">
+                    请从下面的来源中选择要移除的片段：
+                  </Text>
+                  {selection.map((source) => (
+                    <Button
+                      key={source.message_id}
+                      size="xs"
+                      display="block"
+                      width="100%"
+                      textAlign="left"
+                      marginTop="1"
+                      variant="outline"
+                      disabled={busy}
+                      onClick={() =>
+                        void run(
+                          () => forgetMemory(item.memory_id, { fragments: [source.content] }),
+                          '已按所选片段遗忘。',
+                          () => setSelectionFor(''),
+                        )
+                      }
+                    >
+                      {source.content || '（消息已删除）'}
+                    </Button>
+                  ))}
+                </Box>
+              )}
+
+              {impactFor !== item.memory_id && (
+                <Flex marginTop="2">
+                  <Button
+                    size="xs"
+                    variant="outline"
+                    marginRight="2"
+                    onClick={() => {
+                      setEditingId(item.memory_id);
+                      setEditText(item.content);
+                    }}
+                  >
+                    纠正
+                  </Button>
+                  <Button
+                    size="xs"
+                    variant="outline"
+                    colorPalette="red"
+                    disabled={busy}
+                    onClick={() => {
+                      setSelectionFor('');
+                      void startForget(item);
+                    }}
+                  >
+                    遗忘
+                  </Button>
+                </Flex>
+              )}
+            </Box>
+          )}
+        </Box>
+      ))}
+
+      <Heading size="sm" marginTop="6" marginBottom="2">
+        备份恢复
+      </Heading>
+      <Text fontSize="xs" color="whiteAlpha.700" marginBottom="2">
+        恢复备份会用备份内容替换当前本地数据库。如果备份是在删除或遗忘之前创建的，
+        那些内容会一起回来。
+      </Text>
+
+      {restoreWarning && (
+        <Box
+          background="orange.900"
+          borderWidth="1px"
+          borderColor="orange.300"
+          padding="3"
+          marginBottom="3"
+          borderRadius="md"
+        >
+          <Text fontSize="sm" fontWeight="bold">
+            恢复备份前请确认
+          </Text>
+          <Text fontSize="sm">{restoreWarning}</Text>
+        </Box>
+      )}
+
+      {backups.length === 0 ? (
+        <Text fontSize="sm" color="whiteAlpha.700">
+          没有找到备份文件。
+        </Text>
+      ) : (
+        backups.map((backup) => (
+          <Flex
+            key={backup.path}
+            alignItems="center"
+            justifyContent="space-between"
+            borderWidth="1px"
+            borderColor="whiteAlpha.300"
+            borderRadius="md"
+            padding="2"
+            marginBottom="2"
+          >
+            <Text fontSize="sm">
+              {backup.name}（{Math.round(backup.size_bytes / 1024)} KB）
+            </Text>
+            <Button
+              size="xs"
+              colorPalette="orange"
+              disabled={busy}
+              onClick={() => void doRestore(backup, Boolean(restoreWarning))}
+            >
+              {restoreWarning ? '确认恢复' : '恢复'}
+            </Button>
+          </Flex>
+        ))
+      )}
+    </Box>
+  );
+}
diff --git a/src/renderer/src/components/aemeath/voice-page.tsx b/src/renderer/src/components/aemeath/voice-page.tsx
new file mode 100644
index 0000000..a53504c
--- /dev/null
+++ b/src/renderer/src/components/aemeath/voice-page.tsx
@@ -0,0 +1,334 @@
+/* eslint-disable @typescript-eslint/no-explicit-any */
+/**
+ * Voice management page (v2 task V2-T02).
+ *
+ * Two rules from the acceptance criteria shape this screen:
+ *
+ * 1. **A voice can be heard before it is applied, and a failed apply keeps the
+ *    old voice.** Auditioning synthesises a sample without touching the active
+ *    configuration; applying is a separate action that the backend refuses when
+ *    the preset cannot work, leaving the previously working voice in place.
+ * 2. **A sample voice is never described as the official one.** The real
+ *    Aemeath voice material does not exist yet, so every preset from the
+ *    backend carries `is_official_voice: false` and the page says 示例音色
+ *    rather than implying the user is listening to her real voice.
+ *
+ * The page performs no conversation: it does not open the microphone or touch
+ * the character window's audio queue. Auditioning plays a short sample through
+ * a plain `Audio` element, which is replaceable with a controlled playback
+ * entry point when the desktop task wires one up.
+ */
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { Box, Button, Flex, Heading, Input, Text } from '@chakra-ui/react';
+
+import {
+  applyVoice,
+  auditionVoice,
+  createVoicePreset,
+  fetchVoices,
+  type VoiceOverviewResponse,
+  type VoicePreset,
+} from '../../services/aemeath-management';
+
+interface Notice {
+  kind: 'ok' | 'error' | 'info';
+  text: string;
+}
+
+const NOTICE_COLOR: Record<Notice['kind'], string> = {
+  ok: 'green.300',
+  error: 'red.300',
+  info: 'blue.200',
+};
+
+const AUDITION_TEXT = '你好，我是爱弥斯。';
+
+export default function VoicePage(): JSX.Element {
+  const [data, setData] = useState<VoiceOverviewResponse | null>(null);
+  const [loadError, setLoadError] = useState('');
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const [name, setName] = useState('');
+  const [apiUrl, setApiUrl] = useState('http://127.0.0.1:9880/tts');
+  const [refAudio, setRefAudio] = useState('');
+  const [promptText, setPromptText] = useState('');
+
+  const audioRef = useRef<HTMLAudioElement | null>(null);
+
+  const load = useCallback(async () => {
+    try {
+      setData(await fetchVoices());
+      setLoadError('');
+    } catch (error) {
+      setData(null);
+      setLoadError(error instanceof Error ? error.message : String(error));
+    }
+  }, []);
+
+  useEffect(() => {
+    void load();
+    return () => {
+      // Stop any sample still playing when the page goes away.
+      audioRef.current?.pause();
+    };
+  }, [load]);
+
+  const audition = async (preset: VoicePreset) => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await auditionVoice(preset.preset_id, AUDITION_TEXT);
+      if (!result.ok) {
+        setNotice({ kind: 'error', text: result.error || '试听失败。' });
+        return;
+      }
+      const audio = new Audio(`data:audio/${result.media_type || 'wav'};base64,${result.audio}`);
+      audioRef.current?.pause();
+      audioRef.current = audio;
+      await audio.play();
+      setNotice({ kind: 'ok', text: `正在试听「${preset.label || preset.name}」。` });
+    } catch (error) {
+      setNotice({
+        kind: 'error',
+        text: `无法播放试听音频：${error instanceof Error ? error.message : String(error)}`,
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const apply = async (preset: VoicePreset) => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await applyVoice(preset.preset_id, data?.read_error ?? '');
+      if (result.ok) {
+        setNotice({
+          kind: 'ok',
+          text: `已应用「${preset.label || preset.name}」，重启 Aemeath 后生效。`,
+        });
+      } else {
+        setNotice({
+          kind: 'error',
+          text: `${result.error || '应用失败。'}原来的音色保持不变。`,
+        });
+      }
+      await load();
+    } catch (error) {
+      setNotice({
+        kind: 'error',
+        text: `${error instanceof Error ? error.message : String(error)}原来的音色保持不变。`,
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const savePreset = async () => {
+    setBusy(true);
+    setNotice(null);
+    try {
+      const result = await createVoicePreset({
+        name,
+        apiUrl,
+        refAudioPath: refAudio,
+        promptText,
+      });
+      if (result.ok) {
+        setNotice({ kind: 'ok', text: '预设已保存，可先试听再应用。' });
+        setName('');
+        setRefAudio('');
+        setPromptText('');
+      } else {
+        setNotice({ kind: 'error', text: result.error || '保存预设失败。' });
+      }
+      await load();
+    } catch (error) {
+      setNotice({
+        kind: 'error',
+        text: error instanceof Error ? error.message : String(error),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <Box maxWidth="900px">
+      <Heading size="md" marginBottom="2">
+        声音
+      </Heading>
+      <Text fontSize="sm" color="whiteAlpha.800" marginBottom="2">
+        声音由本地 GPT-SoVITS 服务合成。可以先试听，再决定是否应用。
+      </Text>
+
+      <Box
+        background="blackAlpha.400"
+        borderWidth="1px"
+        borderColor="orange.300"
+        padding="3"
+        marginBottom="4"
+        borderRadius="md"
+      >
+        <Text fontSize="sm" fontWeight="bold">
+          当前没有爱弥斯的正式音色
+        </Text>
+        <Text fontSize="sm">
+          正式音色素材尚未提供，这里列出的是示例音色，用于验证语音链路。
+          示例音色不代表爱弥斯的正式声音。
+        </Text>
+      </Box>
+
+      {loadError && (
+        <Box
+          background="red.900"
+          borderWidth="1px"
+          borderColor="red.400"
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontWeight="bold">无法读取声音配置</Text>
+          <Text fontSize="sm">{loadError}</Text>
+          <Button size="sm" marginTop="2" onClick={() => void load()}>
+            重试
+          </Button>
+        </Box>
+      )}
+
+      {notice && (
+        <Box
+          background="blackAlpha.400"
+          borderWidth="1px"
+          borderColor={NOTICE_COLOR[notice.kind]}
+          padding="3"
+          marginBottom="4"
+          borderRadius="md"
+        >
+          <Text fontSize="sm">{notice.text}</Text>
+        </Box>
+      )}
+
+      {data && (
+        <Text fontSize="sm" marginBottom="4" color="whiteAlpha.700">
+          当前语音引擎：{data.engine || '（未配置）'}
+          {data.engine_is_gpt_sovits ? '' : '（尚未切换到本地 GPT-SoVITS）'}
+        </Text>
+      )}
+
+      {data?.presets.map((preset) => {
+        const active = data.active_preset_id === preset.preset_id;
+        return (
+          <Box
+            key={preset.preset_id}
+            borderWidth="1px"
+            borderColor={active ? 'green.300' : 'whiteAlpha.300'}
+            borderRadius="md"
+            padding="3"
+            marginBottom="3"
+          >
+            <Flex alignItems="center" justifyContent="space-between">
+              <Box>
+                <Text fontSize="sm" fontWeight="bold">
+                  {preset.label || preset.name}
+                  {active ? '（使用中）' : ''}
+                </Text>
+                {!preset.is_official_voice && (
+                  <Text fontSize="xs" color="orange.200">
+                    示例音色，不是正式爱弥斯音色
+                  </Text>
+                )}
+              </Box>
+            </Flex>
+
+            {preset.description && (
+              <Text fontSize="xs" color="whiteAlpha.700" marginTop="1">
+                {preset.description}
+              </Text>
+            )}
+
+            <Text fontSize="xs" color="whiteAlpha.600" marginTop="1">
+              参考音频：{preset.ref_audio_path || '（未设置）'}
+            </Text>
+
+            <Flex marginTop="2">
+              <Button
+                size="xs"
+                variant="outline"
+                marginRight="2"
+                disabled={busy}
+                onClick={() => void audition(preset)}
+              >
+                试听
+              </Button>
+              {!preset.builtin && (
+                <Button
+                  size="xs"
+                  colorPalette="blue"
+                  disabled={busy || active}
+                  onClick={() => void apply(preset)}
+                >
+                  {active ? '已应用' : '应用'}
+                </Button>
+              )}
+            </Flex>
+          </Box>
+        );
+      })}
+
+      <Heading size="sm" marginTop="6" marginBottom="2">
+        添加音色预设
+      </Heading>
+      <Text fontSize="xs" color="whiteAlpha.700" marginBottom="3">
+        参考音频决定音色，参考文字必须是该音频的真实转写；写错会让音色与韵律明显变差。
+        训练新声音的向导在后续任务中提供。
+      </Text>
+
+      <Text fontSize="sm" marginBottom="1">
+        名称
+      </Text>
+      <Input
+        value={name}
+        onChange={(e) => setName(e.target.value)}
+        placeholder="例如：我的声音"
+        marginBottom="3"
+      />
+
+      <Text fontSize="sm" marginBottom="1">
+        GPT-SoVITS 服务地址
+      </Text>
+      <Input
+        value={apiUrl}
+        onChange={(e) => setApiUrl(e.target.value)}
+        marginBottom="3"
+      />
+
+      <Text fontSize="sm" marginBottom="1">
+        参考音频路径（本机文件）
+      </Text>
+      <Input
+        value={refAudio}
+        onChange={(e) => setRefAudio(e.target.value)}
+        placeholder="例如：models/ref/my-voice.wav"
+        marginBottom="1"
+      />
+      <Text fontSize="xs" color="whiteAlpha.700" marginBottom="3">
+        参考音频留在本机，不会上传，也不进源码管理。
+      </Text>
+
+      <Text fontSize="sm" marginBottom="1">
+        参考文字（该音频的真实转写）
+      </Text>
+      <Input
+        value={promptText}
+        onChange={(e) => setPromptText(e.target.value)}
+        marginBottom="3"
+      />
+
+      <Button colorPalette="blue" disabled={busy} onClick={() => void savePreset()}>
+        保存预设
+      </Button>
+    </Box>
+  );
+}

@@ -0,0 +1,536 @@
+/**
+ * Aemeath management API client.
+ *
+ * The management surface is the Aemeath FastAPI routes mounted at
+ * `/aemeath/manage/`, **not** the chat WebSocket. It is deliberately a separate
+ * transport:
+ *
+ * - configuration is read and written by HTTP, so the management page works
+ *   while the character session is closed or reconnecting;
+ * - nothing here touches the conversation bridge, so opening the page cannot
+ *   start a second session or a second microphone.
+ *
+ * Field names come from the backend response. There is no second copy of the
+ * contract here; the request bodies only carry what the schemas accept.
+ */
+
+/** A single rejected field, addressed for the UI to focus. */
+export interface FieldError {
+  field: string;
+  message: string;
+}
+
+/** Result of a save attempt. */
+export interface SaveResult {
+  ok: boolean;
+  errors: FieldError[];
+  conflict: boolean;
+  message: string;
+  saved_revision: string;
+  running_revision: string;
+  restart_required: boolean;
+}
+
+/** Conversation model connection. No key value is ever returned. */
+export interface ModelOverview {
+  provider: string;
+  base_url: string;
+  model: string;
+  api_key_configured: boolean;
+  api_key_env: string;
+}
+
+/** Persona as configured, with the legacy text preserved. */
+export interface PersonaOverview {
+  mode: 'legacy' | 'split';
+  identity: string;
+  personality: string;
+  reply_style: string;
+  legacy_prompt: string;
+  active_prompt: string;
+}
+
+/** Everything the overview page shows. */
+export interface OverviewResponse {
+  config_path: string;
+  saved_revision: string;
+  running_revision: string;
+  restart_required: boolean;
+  model: ModelOverview;
+  persona: PersonaOverview;
+  read_error: string;
+}
+
+// ---------------------------------------------------------------------------
+// Memory (V2-T02)
+// ---------------------------------------------------------------------------
+
+/** One message a memory was extracted from. */
+export interface MemorySource {
+  message_id: string;
+  fragment: string;
+  content: string;
+  revision: number;
+}
+
+/** A memory as the management page shows it. */
+export interface MemoryItemView {
+  memory_id: string;
+  kind: string;
+  content: string;
+  valid: boolean;
+  superseded_by: string;
+  created_at: number;
+  updated_at: number;
+  sources: MemorySource[];
+}
+
+/**
+ * A memory listing.
+ *
+ * `available` is the distinction the acceptance criteria require: `ok: false`
+ * with an empty `memories` means the search could not run, which is a different
+ * situation from a memory that is genuinely empty. The page must never render
+ * the first as the second.
+ */
+export interface MemoryListResponse {
+  ok: boolean;
+  available: boolean;
+  error: string;
+  memories: MemoryItemView[];
+}
+
+/** What removing a memory would actually do. */
+export interface MemoryImpact {
+  ok: boolean;
+  error: string;
+  mode: 'precise' | 'cascading' | '';
+  message: string;
+  removes_source_messages: boolean;
+  affected_message_ids: string[];
+}
+
+/** Outcome of a correction or a forgetting. */
+export interface MemoryMutationResponse {
+  ok: boolean;
+  error: string;
+  memory_id: string;
+  needs_selection: MemorySource[];
+  removed_fragments: string[];
+  invalidated_derived: string[];
+  rebuild_required: boolean;
+}
+
+/** One backup file available to restore. */
+export interface BackupEntry {
+  path: string;
+  name: string;
+  size_bytes: number;
+  modified_at: number;
+}
+
+/** Outcome of a restore, carrying the warning either way. */
+export interface RestoreResponse {
+  ok: boolean;
+  error: string;
+  requires_confirmation: boolean;
+  may_restore_forgotten_content: boolean;
+  warning: string;
+  backup_path: string;
+  restored: boolean;
+  restart_required: boolean;
+}
+
+// ---------------------------------------------------------------------------
+// Voice (V2-T02)
+// ---------------------------------------------------------------------------
+
+/** One voice preset. `is_official_voice` is false while no real material exists. */
+export interface VoicePreset {
+  preset_id: string;
+  name: string;
+  label: string;
+  description: string;
+  is_official_voice: boolean;
+  builtin: boolean;
+  api_url: string;
+  ref_audio_path: string;
+  prompt_text: string;
+  text_lang: string;
+  prompt_lang: string;
+  text_split_method: string;
+  batch_size: string;
+  media_type: string;
+  streaming_mode: string;
+}
+
+/** Everything the voice page shows. */
+export interface VoiceOverviewResponse {
+  presets: VoicePreset[];
+  active_preset_id: string;
+  engine: string;
+  engine_is_gpt_sovits: boolean;
+  read_error: string;
+}
+
+/** Audition result; `audio` is base64. */
+export interface VoiceAuditionResponse {
+  ok: boolean;
+  error: string;
+  audio: string;
+  media_type: string;
+}
+
+/** Outcome of creating or applying a preset. */
+export interface VoiceActionResult {
+  ok: boolean;
+  error: string;
+  preset_id: string;
+  conflict: boolean;
+  restart_required: boolean;
+}
+
+// ---------------------------------------------------------------------------
+// Live2D (V2-T02)
+// ---------------------------------------------------------------------------
+
+/** One Live2D model available on this machine. */
+export interface Live2DModel {
+  name: string;
+  label: string;
+  description: string;
+  is_official_model: boolean;
+  is_placeholder: boolean;
+  url: string;
+  scale: number;
+  x_offset: number;
+  y_offset: number;
+  x_shift: number;
+}
+
+/** The Live2D page state. `error` explains a missing model instead of blanking. */
+export interface Live2DOverviewResponse {
+  ok: boolean;
+  error: string;
+  models_root: string;
+  model_dict_path: string;
+  active_model: string;
+  active_model_available: boolean;
+  models: Live2DModel[];
+  active: Live2DModel | null;
+}
+
+/** Outcome of a Live2D save. */
+export interface Live2DSaveResult {
+  ok: boolean;
+  error: string;
+  conflict: boolean;
+  restart_required: boolean;
+}
+
+/** Base path of the management routes. */
+export const MANAGEMENT_BASE = '/aemeath/manage';
+
+/**
+ * Resolve the management API origin.
+ *
+ * In the browser the page is served by the same backend that hosts the routes,
+ * so a relative URL is correct and keeps the loopback restriction satisfied.
+ * Electron loads the renderer from `file://`, where a relative URL has no host;
+ * the backend address is used instead.
+ */
+function managementBaseUrl(): string {
+  if (typeof window !== 'undefined' && window.location.protocol.startsWith('http')) {
+    return MANAGEMENT_BASE;
+  }
+  return `http://127.0.0.1:12393${MANAGEMENT_BASE}`;
+}
+
+/** Error carrying the HTTP status so callers can distinguish a conflict. */
+export class ManagementError extends Error {
+  status: number;
+  payload: SaveResult | null;
+
+  constructor(message: string, status: number, payload: SaveResult | null = null) {
+    super(message);
+    this.name = 'ManagementError';
+    this.status = status;
+    this.payload = payload;
+  }
+}
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  let response: Response;
+  try {
+    response = await fetch(`${managementBaseUrl()}${path}`, {
+      headers: { 'Content-Type': 'application/json' },
+      ...init,
+    });
+  } catch (error) {
+    // A transport failure is reported as its own case: "the backend is not
+    // running" must not be shown as a validation problem in the form.
+    throw new ManagementError(
+      `无法连接管理服务：${error instanceof Error ? error.message : String(error)}`,
+      0,
+      null,
+    );
+  }
+
+  const text = await response.text();
+  let data: unknown = null;
+  try {
+    data = text ? JSON.parse(text) : null;
+  } catch {
+    throw new ManagementError('管理服务返回了无法解析的内容。', response.status, null);
+  }
+
+  if (!response.ok) {
+    const payload = (data ?? null) as SaveResult | null;
+    const message =
+      (payload && payload.message) ||
+      (payload && payload.errors?.length ? payload.errors[0].message : '') ||
+      `请求失败（HTTP ${response.status}）`;
+    throw new ManagementError(message, response.status, payload);
+  }
+
+  return data as T;
+}
+
+/** Read the current model, persona and revision state. */
+export async function fetchOverview(): Promise<OverviewResponse> {
+  return request<OverviewResponse>('/overview');
+}
+
+/**
+ * Save the conversation model connection.
+ *
+ * `expectedRevision` is required by the backend; omitting it would let this
+ * client overwrite a change made elsewhere.
+ */
+export async function saveModel(input: {
+  baseUrl: string;
+  model: string;
+  apiKey?: string;
+  expectedRevision: string;
+}): Promise<SaveResult> {
+  return request<SaveResult>('/model', {
+    method: 'POST',
+    body: JSON.stringify({
+      base_url: input.baseUrl,
+      model: input.model,
+      api_key: input.apiKey || null,
+      expected_revision: input.expectedRevision,
+    }),
+  });
+}
+
+/** Save the three persona fields. */
+export async function savePersona(input: {
+  identity: string;
+  personality: string;
+  replyStyle: string;
+  expectedRevision: string;
+}): Promise<SaveResult> {
+  return request<SaveResult>('/persona', {
+    method: 'POST',
+    body: JSON.stringify({
+      identity: input.identity,
+      personality: input.personality,
+      reply_style: input.replyStyle,
+      expected_revision: input.expectedRevision,
+    }),
+  });
+}
+
+/**
+ * Whether a change is saved but not yet adopted by the running service.
+ *
+ * Kept as one function so every screen answers the question the same way: a
+ * successful save is not the same thing as a running change.
+ */
+export function describeEffectState(overview: OverviewResponse): {
+  label: string;
+  detail: string;
+  pending: boolean;
+} {
+  if (overview.read_error) {
+    return {
+      label: '读取失败',
+      detail: overview.read_error,
+      pending: false,
+    };
+  }
+  if (overview.restart_required) {
+    return {
+      label: '已保存，尚未生效',
+      detail: '配置已写入本地文件，重启 Aemeath 后生效。',
+      pending: true,
+    };
+  }
+  return {
+    label: '已生效',
+    detail: '运行中的服务正在使用当前配置。',
+    pending: false,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Memory API (V2-T02)
+// ---------------------------------------------------------------------------
+
+/** List every memory, including ones the search index cannot reach. */
+export async function fetchMemories(): Promise<MemoryListResponse> {
+  return request<MemoryListResponse>('/memory/list');
+}
+
+/** Search the memory by meaning. An empty query lists everything. */
+export async function searchMemories(
+  query: string,
+  limit = 20,
+): Promise<MemoryListResponse> {
+  return request<MemoryListResponse>('/memory/search', {
+    method: 'POST',
+    body: JSON.stringify({ query, limit }),
+  });
+}
+
+/** What removing this memory would actually do, before acting. */
+export async function fetchMemoryImpact(memoryId: string): Promise<MemoryImpact> {
+  return request<MemoryImpact>(`/memory/${encodeURIComponent(memoryId)}/impact`);
+}
+
+/** Replace a memory's content; the old one is kept for provenance. */
+export async function correctMemory(
+  memoryId: string,
+  content: string,
+): Promise<MemoryMutationResponse> {
+  return request<MemoryMutationResponse>('/memory/correct', {
+    method: 'POST',
+    body: JSON.stringify({ memory_id: memoryId, content }),
+  });
+}
+
+/**
+ * Forget one fact.
+ *
+ * `confirmCascading` must be set when the memory has no locatable span: the
+ * operation then also removes the source messages, and the backend refuses
+ * until that is accepted rather than doing it silently.
+ */
+export async function forgetMemory(
+  memoryId: string,
+  options: { fragments?: string[]; confirmCascading?: boolean } = {},
+): Promise<MemoryMutationResponse> {
+  return request<MemoryMutationResponse>('/memory/forget', {
+    method: 'POST',
+    body: JSON.stringify({
+      memory_id: memoryId,
+      fragments: options.fragments ?? null,
+      confirm_cascading: options.confirmCascading ?? false,
+    }),
+  });
+}
+
+/** Backups available to restore. */
+export async function fetchBackups(): Promise<{
+  ok: boolean;
+  error: string;
+  backups: BackupEntry[];
+}> {
+  return request('/memory/backups');
+}
+
+/** Restore a backup. The warning is returned whether or not it runs. */
+export async function restoreBackup(
+  backupPath: string,
+  confirm: boolean,
+): Promise<RestoreResponse> {
+  return request<RestoreResponse>('/memory/restore', {
+    method: 'POST',
+    body: JSON.stringify({ backup_path: backupPath, confirm }),
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Voice API (V2-T02)
+// ---------------------------------------------------------------------------
+
+/** Presets, the active one, and the configured engine. */
+export async function fetchVoices(): Promise<VoiceOverviewResponse> {
+  return request<VoiceOverviewResponse>('/voice/overview');
+}
+
+/** Save a preset without activating it. */
+export async function createVoicePreset(input: {
+  name: string;
+  apiUrl: string;
+  refAudioPath: string;
+  promptText: string;
+  textLang?: string;
+  promptLang?: string;
+  expectedRevision?: string;
+}): Promise<VoiceActionResult> {
+  return request<VoiceActionResult>('/voice/preset', {
+    method: 'POST',
+    body: JSON.stringify({
+      name: input.name,
+      api_url: input.apiUrl,
+      ref_audio_path: input.refAudioPath,
+      prompt_text: input.promptText,
+      text_lang: input.textLang ?? 'zh',
+      prompt_lang: input.promptLang ?? 'zh',
+      expected_revision: input.expectedRevision ?? '',
+    }),
+  });
+}
+
+/** Make a preset the active voice. A failure leaves the previous voice in place. */
+export async function applyVoice(
+  presetId: string,
+  expectedRevision = '',
+): Promise<VoiceActionResult> {
+  return request<VoiceActionResult>('/voice/apply', {
+    method: 'POST',
+    body: JSON.stringify({ preset_id: presetId, expected_revision: expectedRevision }),
+  });
+}
+
+/** Synthesise a sample without applying the preset. */
+export async function auditionVoice(
+  presetId: string,
+  text: string,
+): Promise<VoiceAuditionResponse> {
+  return request<VoiceAuditionResponse>('/voice/audition', {
+    method: 'POST',
+    body: JSON.stringify({ preset_id: presetId, text }),
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Live2D API (V2-T02)
+// ---------------------------------------------------------------------------
+
+/** Installed models, the active one, and what is missing. */
+export async function fetchLive2D(): Promise<Live2DOverviewResponse> {
+  return request<Live2DOverviewResponse>('/live2d/overview');
+}
+
+/** Select a model and save its scale and position. */
+export async function saveLive2D(input: {
+  modelName: string;
+  scale: number;
+  xOffset: number;
+  yOffset: number;
+  expectedRevision: string;
+}): Promise<Live2DSaveResult> {
+  return request<Live2DSaveResult>('/live2d/save', {
+    method: 'POST',
+    body: JSON.stringify({
+      model_name: input.modelName,
+      scale: input.scale,
+      x_offset: input.xOffset,
+      y_offset: input.yOffset,
+      expected_revision: input.expectedRevision,
+    }),
+  });
+}

diff --git a/src/renderer/src/services/aemeath-protocol.ts b/src/renderer/src/services/aemeath-protocol.ts
new file mode 100644
index 0000000..5154b61
--- /dev/null
+++ b/src/renderer/src/services/aemeath-protocol.ts
@@ -0,0 +1,180 @@
+/* eslint-disable @typescript-eslint/no-explicit-any */
+/**
+ * Aemeath client protocol state.
+ *
+ * The backend tags every frame with a connection generation, a turn id, an
+ * audio slice id and a situation state version. Two things depend on those
+ * fields and are the reason this module exists:
+ *
+ * 1. **Stale output rejection.** When the user switches to class mode or
+ *    interrupts, audio that was already synthesised must be discarded rather
+ *    than played. The backend drops most of it, but a frame already in flight
+ *    has to be rejected here too, on the client.
+ * 2. **Honest metrics.** The durations the user actually experiences are
+ *    measured here with a single monotonic clock and reported as one number,
+ *    so the backend never has to subtract two different time bases.
+ */
+
+/** Protocol version this client speaks. */
+export const AEMEATH_PROTOCOL_VERSION = 2;
+
+/** Situation state as reported by the backend. */
+export interface AemeathState {
+  mode: 'normal' | 'class';
+  state_version: number;
+  microphone_enabled: boolean;
+  screen_observation_enabled: boolean;
+  proactive_enabled: boolean;
+  user_paused: boolean;
+  voice_allowed: boolean;
+}
+
+/**
+ * Tracks which output is still valid.
+ *
+ * It is deliberately a plain class rather than React state: the audio queue
+ * consults it synchronously while playing, and a stale value from a render
+ * closure is exactly the bug this is meant to prevent.
+ */
+export class AemeathProtocolState {
+  /** Connection generation; frames from an older generation are ignored. */
+  generation = 0;
+
+  /** Latest situation state version seen from the backend. */
+  stateVersion = 0;
+
+  mode: 'normal' | 'class' = 'normal';
+
+  voiceAllowed = true;
+
+  /** Turn ids cancelled locally, e.g. by the stop button. */
+  private cancelledTurns = new Set<string>();
+
+  /** Slice ids already played, so a duplicate frame is not played twice. */
+  private playedSlices = new Set<string>();
+
+  /** Whether the client negotiated the Aemeath protocol at all. */
+  negotiated = false;
+
+  /**
+   * Handle a state update from the backend.
+   *
+   * Older versions are ignored so an out-of-order frame cannot restore a mode
+   * the user has already left.
+   */
+  applyState(state: AemeathState, generation?: number): boolean {
+    if (generation !== undefined && generation < this.generation) {
+      return false;
+    }
+    if (state.state_version < this.stateVersion) {
+      return false;
+    }
+    this.stateVersion = state.state_version;
+    this.mode = state.mode;
+    this.voiceAllowed = state.voice_allowed;
+    return true;
+  }
+
+  /** Record a new connection generation, invalidating older output. */
+  setGeneration(generation: number): void {
+    this.generation = generation;
+    // Everything from the previous connection is void.
+    this.cancelledTurns.clear();
+    this.playedSlices.clear();
+    this.stateVersion = 0;
+  }
+
+  /** Mark a turn cancelled so its late frames are refused. */
+  cancelTurn(turnId: string): void {
+    if (turnId) this.cancelledTurns.add(turnId);
+  }
+
+  /** Cancel every turn, as an interrupt or a mode switch does. */
+  cancelAllTurns(): void {
+    this.cancelledTurns.add('*');
+  }
+
+  /** Reset catch-all cancellation so newly started turns can play. */
+  resetCancelledAll(): void {
+    this.cancelledTurns.delete('*');
+  }
+
+  /** Whether output for a turn is still valid. */
+  isTurnValid(turnId?: string | null): boolean {
+    if (this.cancelledTurns.has('*')) return false;
+    if (!turnId) return true;
+    return !this.cancelledTurns.has(turnId);
+  }
+
+  /** Whether a slice may be played, and record it as played. */
+  claimSlice(sliceId?: string | null): boolean {
+    if (!sliceId) return true;
+    if (this.playedSlices.has(sliceId)) return false;
+    this.playedSlices.add(sliceId);
+    return true;
+  }
+
+  /** Whether audio is permitted in the current mode. */
+  audioPermitted(): boolean {
+    return this.mode === 'normal' && this.voiceAllowed;
+  }
+
+  /**
+   * Decide whether an incoming audio frame should be played.
+   *
+   * This is the client-side check the plan requires: a frame that is valid for
+   * a turn but marked with an older state version, or that arrives while the
+   * client is muted, must not be queued.
+   */
+  shouldAcceptAudio(frame: {
+    turn_id?: string;
+    audio_slice_id?: string;
+    state_version?: number;
+    generation?: number;
+  }): boolean {
+    if (frame.generation !== undefined && frame.generation < this.generation) {
+      return false;
+    }
+    if (
+      frame.state_version !== undefined &&
+      frame.state_version < this.stateVersion
+    ) {
+      return false;
+    }
+    if (!this.isTurnValid(frame.turn_id)) return false;
+    if (!this.audioPermitted()) return false;
+    return true;
+  }
+}
+
+/**
+ * Monotonic stopwatch used for user-experienced latency.
+ *
+ * `performance.now()` shares one origin within the page, so every duration
+ * measured here is directly comparable with every other one — unlike wall
+ * clock values, which must never be subtracted across processes.
+ */
+export class ClientStopwatch {
+  private start = 0;
+
+  /** Begin measuring. */
+  begin(): void {
+    this.start = now();
+  }
+
+  /** Elapsed milliseconds since :meth:`begin`. */
+  elapsed(): number {
+    return Math.max(0, now() - this.start);
+  }
+}
+
+/** Monotonic clock, falling back when `performance` is unavailable. */
+export function now(): number {
+  if (typeof performance !== 'undefined' && typeof performance.now === 'function') {
+    return performance.now();
+  }
+  return Date.now();
+}
+
+/** Shared protocol state for the whole client. */
+export const aemeathProtocol = new AemeathProtocolState();

+
+/** One step of the wizard, as the page renders it. */
+export interface TrainingStepView {
+  id: string;
+  label: string;
+  done: boolean;
+  current: boolean;
+}
+
+/** Everything the wizard knows about one training task.
+ *
+ * There is deliberately no progress percentage: upstream reports no reliable
+ * one, so the page shows the step and the run state instead of inventing a bar.
+ */
+export interface TrainingJobView {
+  job_id: string;
+  voice_name: string;
+  exp_name: string;
+  /** pending / running / awaiting_proofread / stopping / stopped / failed / succeeded */
+  state: string;
+  stage: string;
+  detail: string;
+  error: string;
+  /** `infrastructure`, `material`, `environment` or empty. */
+  error_kind: string;
+  pid: number | null;
+  steps: TrainingStepView[];
+  artifacts: { path: string; size_bytes: number }[];
+  applied_preset_id: string;
+  upstream_commit: string;
+  upstream_dirty: boolean | null;
+  created_at: number;
+  updated_at: number;
+}
+
+/**
+ * The wizard page payload.
+ *
+ * `available` is separate from `jobs` because "no task started yet" and "the
+ * task store cannot be read" need different actions from the user.
+ */
+export interface TrainingOverviewResponse {
+  ok: boolean;
+  available: boolean;
+  error: string;
+  jobs: TrainingJobView[];
+  steps: { id: string; label: string; hint: string }[];
+  current: TrainingJobView | null;
+}
+
+/** One clip the user reviews during proofreading. */
+export interface TrainingClip {
+  path: string;
+  name: string;
+  text: string;
+  exists: boolean;
+}
+
+/** Outcome of a wizard action.
+ *
+ * `retryable` is not the same as `ok`: it says whether the failure *may* be
+ * repeated, while `ok` says whether this call did what it was asked to.
+ */
+export interface TrainingActionResult {
+  ok: boolean;
+  error: string;
+  retryable: boolean;
+  reason: string;
+  conflict: boolean;
+  job_id: string;
+  state: string;
+  pid: number | null;
+}
+
+/** Environment readiness for training. */
+export interface TrainingPreflight {
+  ok: boolean;
+  /** Problems that prevent training. */
+  blocking: string[];
+  /** Problems worth knowing about that do not prevent training. */
+  warnings: string[];
+  recovery: { problem: string; action: string }[];
+  ddp: { ok: boolean; patched: boolean; error: string; recovery: string };
+  ffmpeg: { available: boolean; path: string; error: string; recovery: string };
+  environment: Record<string, unknown>;
+}
+
+/** A synthesised audition sample; `audio` is base64. */
+export interface TrainingAuditionResponse {
+  ok: boolean;
+  error: string;
+  audio: string;
+  media_type: string;
+  weights: string;
+}
+
+/** List training tasks. */
+export async function fetchTraining(jobId = ''): Promise<TrainingOverviewResponse> {
+  const suffix = jobId ? `?job_id=${encodeURIComponent(jobId)}` : '';
+  return request<TrainingOverviewResponse>(`/training/overview${suffix}`);
+}
+
+/** Environment readiness, including the single-GPU DDP precondition. */
+export async function fetchTrainingPreflight(): Promise<TrainingPreflight> {
+  return request<TrainingPreflight>('/training/preflight');
+}
+
+/** One task's full state, including its steps and artefacts. */
+export async function fetchTrainingJob(
+  jobId: string,
+): Promise<{ ok: boolean; error: string; job: TrainingJobView | null }> {
+  return request(`/training/${encodeURIComponent(jobId)}`);
+}
+
+/** Step 1: open a task for a material set. */
+export async function importTrainingMaterial(input: {
+  voiceName: string;
+  materialDir?: string;
+  listPath?: string;
+}): Promise<TrainingActionResult & { clip_count?: number; total_seconds?: number }> {
+  return request('/training/import', {
+    method: 'POST',
+    body: JSON.stringify({
+      voice_name: input.voiceName,
+      material_dir: input.materialDir || null,
+      list_path: input.listPath || null,
+    }),
+  });
+}
+
+/** Step 2: clean and split the material. Long-running. */
+export async function prepareTrainingJob(
+  jobId: string,
+): Promise<TrainingActionResult & { reused?: boolean }> {
+  return request(`/training/${encodeURIComponent(jobId)}/prepare`, { method: 'POST' });
+}
+
+/** Step 3: read the clips and transcripts to review. */
+export async function fetchTrainingClips(
+  jobId: string,
+): Promise<{ ok: boolean; error: string; clips: TrainingClip[]; confirmed: boolean }> {
+  // The overview endpoint returns the job; the clips come from the same
+  // proofreading view the submit endpoint writes, so they are read here.
+  return request(`/training/${encodeURIComponent(jobId)}/proofread`);
+}
+
+/** Step 3: submit the corrected transcripts. Only a human closes this step. */
+export async function submitTrainingProofread(
+  jobId: string,
+  clips: { path: string; text: string }[],
+): Promise<TrainingActionResult> {
+  return request(`/training/${encodeURIComponent(jobId)}/proofread`, {
+    method: 'POST',
+    body: JSON.stringify({ clips }),
+  });
+}
+
+/** Step 4: start training. Returns as soon as the process is launched. */
+export async function startTraining(
+  jobId: string,
+  options: { epochs?: number; batchSize?: number; ifGradCkpt?: boolean } = {},
+): Promise<TrainingActionResult> {
+  return request(`/training/${encodeURIComponent(jobId)}/train`, {
+    method: 'POST',
+    body: JSON.stringify({
+      epochs: options.epochs ?? 8,
+      batch_size: options.batchSize ?? 1,
+      if_grad_ckpt: options.ifGradCkpt ?? false,
+    }),
+  });
+}
+
+/** Stop a run this application started. Scoped to its own PID. */
+export async function stopTraining(jobId: string): Promise<TrainingActionResult> {
+  return request(`/training/${encodeURIComponent(jobId)}/stop`, { method: 'POST' });
+}
+
+/** Repeat a run that may soundly be repeated. */
+export async function retryTraining(jobId: string): Promise<TrainingActionResult> {
+  return request(`/training/${encodeURIComponent(jobId)}/retry`, { method: 'POST' });
